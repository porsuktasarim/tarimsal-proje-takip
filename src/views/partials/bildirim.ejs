<%
  var metinler = {
    olusturuldu: ['success', 'ti-check', 'Proje başlatıldı.'],
    guncellendi: ['success', 'ti-check', 'Proje bilgileri güncellendi.'],
    durum: ['success', 'ti-check', 'Proje durumu değiştirildi.'],
    silindi: ['success', 'ti-trash', 'Proje silindi.'],
    silinemez: ['warning', 'ti-alert-triangle', 'Yalnızca taslak projeler silinebilir. Yürütülen bir projenin durumu "İptal" yapılabilir.'],
    kaydedildi: ['success', 'ti-check', 'Değişiklikler kaydedildi.'],
    'urun-silindi': ['success', 'ti-trash', 'Ürün katalogdan silindi.'],
    'urun-kullaniliyor': ['warning', 'ti-alert-triangle', 'Bu ürün projelerde kullanıldığı için silinemez.'],
    'kisi-silindi': ['success', 'ti-trash', 'Kişi silindi.'],
    'kisi-kullaniliyor': ['warning', 'ti-alert-triangle', 'Bu kişi projelerde ya da görevlerde geçtiği için silinemez; "Aktif" işareti kaldırılarak listelerden çıkarılabilir.'],
    'gorev-olusturuldu': ['success', 'ti-check', 'Görev oluşturuldu.'],
    'gorev-guncellendi': ['success', 'ti-check', 'Görev güncellendi.'],
    'gorev-silindi': ['success', 'ti-trash', 'Görev silindi.'],
    'not-eklendi': ['success', 'ti-message-check', 'Not eklendi.'],
    'ciftci-silindi': ['success', 'ti-trash', 'Çiftçi kaydı silindi.'],
    'ciftci-talepli': ['warning', 'ti-alert-triangle', 'Talebi bulunan çiftçinin kaydı silinemez.'],
    'talep-kaydedildi': ['success', 'ti-check', 'Talep kaydedildi.'],
    'talep-durum': ['success', 'ti-check', 'Talep durumu değiştirildi.'],
    'talep-silindi': ['success', 'ti-trash', 'Talep silindi.']
  };
  var b = bildirim && metinler[bildirim];
%>
<% if (b) { %>
  <div class="alert alert-<%= b[0] %> alert-dismissible" role="alert">
    <div class="alert-icon"><i class="ti <%= b[1] %>"></i></div>
    <div><%= b[2] %></div>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
  </div>
<% } %>
