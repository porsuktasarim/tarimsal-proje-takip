<%- include('../../../views/partials/ust') %>
<%
  var d = sabitler.projeDurumlari[proje.durum];
  var eylemler = izin('proje.yonet') ? '<a href="/projeler/' + proje._id + '/duzenle" class="btn"><i class="ti ti-edit me-1"></i> Düzenle</a>' : '';
  var ekim = ayar.ekimNormu;
  var ciktiNormlari = ayar.ciktiNormlari;
  var bilgiNormlari = ayar.normlar.filter(function (n) { return n.tip === 'bilgi'; });
  var miktarlar = Object.keys(hesap.miktarToplamlari);
%>
<%- include('../../../views/partials/sayfa-basligi', { ustBaslik: proje.birim, eylemler: eylemler }) %>

<div class="page-body">
  <div class="container-xl">
    <%- include('../../../views/partials/bildirim') %>
    <% if (katalogEklenen) { %>
      <div class="alert alert-info alert-dismissible" role="alert">
        <div class="alert-icon"><i class="ti ti-seeding"></i></div>
        <div>Ürün kataloğuna <%= katalogEklenen %> yeni ürün/çeşit eklendi. Varsayılan normları <a href="/ayarlar/urunler">Ürün kataloğu</a>ndan gözden geçirilebilir.</div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
      </div>
    <% } %>

    <div class="row row-cards mb-3">
      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm"><div class="card-body">
          <div class="text-secondary">Durum</div>
          <div class="h3 mb-0 mt-1"><span class="badge bg-<%= d.renk %>-lt"><%= d.ad %></span></div>
        </div></div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm"><div class="card-body">
          <div class="text-secondary">İlçe / hedef çiftçi</div>
          <div class="h2 mb-0"><%= proje.ilceler.length %> <span class="text-secondary fw-normal">/</span> <%= y.sayi(proje.toplamHedefCiftci) %></div>
        </div></div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm"><div class="card-body">
          <div class="text-secondary">Hedef alan</div>
          <div class="h2 mb-0"><%= y.sayi(hesap.toplamDekar) %> <span class="fs-4 text-secondary fw-normal">da</span></div>
        </div></div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card card-sm"><div class="card-body">
          <div class="text-secondary">Dağıtılacak miktar</div>
          <div class="h2 mb-0">
            <% if (miktarlar.length) { miktarlar.forEach(function (b, i) { %><%= i ? ' · ' : '' %><%= y.miktar(hesap.miktarToplamlari[b], b) %><% }) } else { %>–<% } %>
          </div>
        </div></div>
      </div>
    </div>

    <div class="row row-cards">
      <div class="col-lg-4">
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Proje bilgileri</h3></div>
          <div class="card-body">
            <dl class="row mb-0">
              <% if (proje.kisaAd) { %><dt class="col-5">Kısa ad</dt><dd class="col-7"><%= proje.kisaAd %></dd><% } %>
              <dt class="col-5">Birim</dt><dd class="col-7"><%= proje.birim %></dd>
              <dt class="col-5">Dönem</dt><dd class="col-7"><%= proje.donem || '–' %></dd>
              <dt class="col-5">Başlangıç</dt><dd class="col-7"><%= y.tarih(proje.baslangicTarihi) %></dd>
              <dt class="col-5">Bitiş</dt><dd class="col-7"><%= y.tarih(proje.bitisTarihi) %></dd>
              <dt class="col-5">Kayıt</dt><dd class="col-7"><%= y.tarih(proje.olusturulma) %></dd>
            </dl>
            <% if (proje.aciklama) { %>
              <hr class="my-3">
              <div class="text-secondary" style="white-space: pre-line"><%= proje.aciklama %></div>
            <% } %>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Proje ekibi</h3></div>
          <div class="card-body">
            <% [['Proje koordinatörleri', koordinatorler], ['Proje yürütücüleri', yurutuculer]].forEach(function (g, gi) { %>
              <div class="subheader mb-2<%= gi ? ' mt-3' : '' %>"><%= g[0] %></div>
              <% if (!g[1].length) { %><div class="text-secondary small">Atanmadı</div><% } %>
              <% g[1].forEach(function (k) { %>
                <div class="d-flex align-items-center mb-2">
                  <span class="avatar avatar-sm bg-<%= ayar.rolRenk[k.rol] %>-lt me-2"><%= k.adSoyad.split(/\s+/).map(function (p) { return p[0]; }).slice(0, 2).join('').toLocaleUpperCase('tr') %></span>
                  <div class="flex-fill">
                    <div><%= k.adSoyad %></div>
                    <div class="text-secondary small"><%= [k.unvan, (k.ilceler || []).join(', ')].filter(Boolean).join(' · ') %></div>
                  </div>
                  <% if (izin('gorev.ver')) { %><a href="/gorevler/yeni?kisi=<%= k._id %>&proje=<%= proje._id %>&geri=/projeler/<%= proje._id %>" class="btn btn-ghost-secondary btn-icon btn-sm" title="Görev ver"><i class="ti ti-checklist"></i></a><% } %>
                </div>
              <% }) %>
            <% }) %>
          </div>
        </div>

        <div class="card mb-3<%= izin('proje.yonet') ? '' : ' d-none' %>">
          <div class="card-header"><h3 class="card-title">Durum</h3></div>
          <div class="card-body">
            <form method="post" action="/projeler/<%= proje._id %>/durum" class="d-flex gap-2">
              <select name="durum" class="form-select">
                <% Object.keys(sabitler.projeDurumlari).forEach(function (k) { %>
                  <option value="<%= k %>" <%= proje.durum === k ? 'selected' : '' %>><%= sabitler.projeDurumlari[k].ad %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn">Değiştir</button>
            </form>
            <% if (proje.durum === 'taslak') { %>
              <form method="post" action="/projeler/<%= proje._id %>/sil" class="mt-3"
                    data-onay="Bu taslak proje kalıcı olarak silinecek. Devam edilsin mi?">
                <button type="submit" class="btn btn-ghost-danger w-100"><i class="ti ti-trash me-1"></i> Taslağı sil</button>
              </form>
            <% } %>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">İlçe hedefleri</h3></div>
          <div class="table-responsive ilce-tablosu-kap">
            <table class="table table-sm table-vcenter card-table">
              <thead>
                <tr><th>İlçe</th><th class="tablo-sayi">Çiftçi</th><th class="tablo-sayi">Dekar</th></tr>
              </thead>
              <tbody>
                <% proje.ilceler.forEach(function (h) { %>
                  <tr>
                    <td><%= h.ilce %></td>
                    <td class="tablo-sayi"><%= y.sayi(h.hedefCiftci) %></td>
                    <td class="tablo-sayi"><%= y.sayi(h.hedefDekar) %></td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr class="fw-bold">
                  <td>Toplam</td>
                  <td class="tablo-sayi"><%= y.sayi(proje.toplamHedefCiftci) %></td>
                  <td class="tablo-sayi"><%= y.sayi(proje.toplamHedefDekar) %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <!-- Kalemler ve dağıtım miktarı -->
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title">Kalemler ve dağıtım</h3>
              <p class="card-subtitle">İhtiyaç = alan × <%= ekim ? ekim.ad.toLocaleLowerCase('tr') : 'ekim normu' %>; dağıtım birimi ambalajsa ambalaj içeriğine bölünür.</p>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-vcenter card-table">
              <thead>
                <tr>
                  <th>Kalem</th>
                  <th class="tablo-sayi">Alan</th>
                  <% if (ekim) { %><th class="tablo-sayi"><%= ekim.ad %></th><th class="tablo-sayi">İhtiyaç</th><% } %>
                  <th class="tablo-sayi">Dağıtılacak</th>
                </tr>
              </thead>
              <tbody>
                <% hesap.kalemler.forEach(function (h) { var k = h.kalem; %>
                  <tr>
                    <td>
                      <span class="badge bg-green-lt me-1"><%= k.tur %></span>
                      <span class="fw-medium"><%= k.urun %></span><% if (k.cesit) { %> <span class="text-secondary">· <%= k.cesit %></span><% } %>
                      <% if (h.ambalaj) { %><div class="text-secondary small"><i class="ti ti-package"></i> 1 <%= k.olcuBirimi %> = <%= y.sayi(h.ambalaj.miktar) %> <%= h.ambalaj.birim %></div><% } %>
                      <% if (k.aciklama) { %><div class="text-secondary small"><%= k.aciklama %></div><% } %>
                    </td>
                    <td class="tablo-sayi text-nowrap">
                      <%= h.alan != null ? y.sayi(h.alan) + ' da' : '–' %>
                      <% if (h.alanKaynak === 'proje') { %><div class="text-secondary small">ilçe toplamı</div><% } %>
                    </td>
                    <% if (ekim) { %>
                      <td class="tablo-sayi text-nowrap"><%= h.ekimDegeri != null ? y.sayi(h.ekimDegeri) + ' ' + h.ekimBirimi : '–' %></td>
                      <td class="tablo-sayi text-nowrap">
                        <%= h.ihtiyac != null ? y.miktar(h.ihtiyac, h.ihtiyacBirimi) : '–' %>
                      </td>
                    <% } %>
                    <td class="tablo-sayi text-nowrap">
                      <span class="fw-medium"><%= y.miktar(h.miktar, k.olcuBirimi) %></span>
                      <% if (h.miktarKaynak === 'hesap') { %><div class="text-secondary small">hesaplanan</div><% } %>
                      <% if (h.miktarKaynak === 'elle') { %><div class="text-secondary small">elle girildi</div><% } %>
                      <% if (h.miktarKaynak === 'elle' && h.hesaplananMiktar != null && Math.abs(h.hesaplananMiktar - h.miktar) > 0.0001) { %>
                        <div class="text-warning small">hesap: <%= y.miktar(h.hesaplananMiktar, k.olcuBirimi) %></div>
                      <% } %>
                      <% if (h.birimUyumsuz && h.miktarKaynak !== 'elle') { %>
                        <div class="text-warning small" title="Ekim normunun birimi (<%= h.ekimBirimi %>) ambalaj içeriğinin birimiyle aynı olmalıdır. Kalem düzenlenip kaydedildiğinde birimler eşitlenir.">
                          <i class="ti ti-alert-triangle"></i> <%= h.ambalaj ? 'birimler uyuşmuyor' : 'ambalaj içeriği girilmeli' %>
                        </div>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (hesap.kalemAlanToplami != null && hesap.alanFarki) { %>
            <div class="card-footer text-secondary small">
              <i class="ti ti-info-circle"></i> Kalem alanlarının toplamı <%= y.sayi(hesap.kalemAlanToplami) %> da, ilçe hedeflerinin toplamı <%= y.sayi(hesap.toplamDekar) %> da.
              Karışım ekimlerinde aynı alan birden fazla kalemde yer alabilir.
            </div>
          <% } %>
        </div>

        <!-- Bütçe ve finansman -->
        <%
          var fin = proje.finansman || {};
          var oran = fin.ciftciKatkiOrani;
        %>
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title">Bütçe ve finansman</h3>
              <p class="card-subtitle">Hedef miktarlar üzerinden; birim fiyat kalem düzenlenerek girilir.</p>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-vcenter card-table">
              <thead>
                <tr>
                  <th>Girdi</th>
                  <th class="tablo-sayi">Miktar</th>
                  <th class="tablo-sayi">Birim fiyat</th>
                  <th class="tablo-sayi">Toplam</th>
                </tr>
              </thead>
              <tbody>
                <% hesap.kalemler.forEach(function (h) { var k = h.kalem; %>
                  <tr>
                    <td><span class="fw-medium"><%= k.urun %></span><% if (k.cesit) { %> <span class="text-secondary">· <%= k.cesit %></span><% } %></td>
                    <td class="tablo-sayi text-nowrap">
                      <%= h.teslim != null ? y.sayi(h.teslim) + ' ' + h.teslimBirimi : '–' %>
                      <% if (h.ambalaj && h.miktar != null) { %><div class="text-secondary small"><%= y.sayi(h.miktar) %> <%= k.olcuBirimi %></div><% } %>
                    </td>
                    <td class="tablo-sayi text-nowrap"><%= k.birimFiyat != null ? y.para(k.birimFiyat) + ' / ' + h.fiyatBirimi : '–' %></td>
                    <td class="tablo-sayi text-nowrap"><%= y.para(h.bedel) %></td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr class="fw-bold">
                  <td colspan="3">Toplam proje bütçesi</td>
                  <td class="tablo-sayi text-nowrap"><%= y.para(hesap.butce.toplam) %></td>
                </tr>
              </tfoot>
            </table>
          </div>
          <div class="card-body">
            <% if (hesap.butce.fiyatsizKalem) { %>
              <div class="text-warning small mb-2"><i class="ti ti-alert-triangle"></i> <%= hesap.butce.fiyatsizKalem %> kalemde birim fiyat girilmemiş.</div>
            <% } %>
            <% if (oran == null) { %>
              <div class="text-secondary small">Çiftçi katkı oranı girilmemiş; proje düzenlenerek "Finansman ve başvuru" bölümünden girilebilir.</div>
            <% } else { %>
              <div class="datagrid">
                <div class="datagrid-item">
                  <div class="datagrid-title"><%= fin.destekKaynagi || 'Destek' %> katkısı · %<%= y.sayi(100 - oran) %></div>
                  <div class="datagrid-content fw-medium"><%= y.para(hesap.butce.destek) %></div>
                </div>
                <div class="datagrid-item">
                  <div class="datagrid-title">Çiftçi katkısı · %<%= y.sayi(oran) %></div>
                  <div class="datagrid-content fw-medium"><%= y.para(hesap.butce.ciftciKatkisi) %></div>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Hedef çıktılar -->
        <%
          var toplamMetni = function (t) {
            var b = Object.keys(t);
            return b.length ? b.map(function (k) { return y.miktar(t[k], k); }).join(' + ') : '–';
          };
        %>
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title">Hedef çıktılar</h3>
              <p class="card-subtitle">Alan × kalemdeki çıktı normu. Normlar kalem düzenlenerek değiştirilebilir.</p>
            </div>
          </div>
          <% if (!ciktiNormlari.length) { %>
            <div class="card-body text-secondary">Çıktı türünde norm tanımlı değil. <a href="/ayarlar/normlar">Hesaplama normları</a>ndan eklenebilir.</div>
          <% } else if (!hesap.ciktiVar) { %>
            <div class="card-body text-secondary">Kalemlerde alan ya da çıktı normu girilmediği için hesaplanacak değer yok.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-vcenter card-table">
                <thead>
                  <tr>
                    <th>Kalem</th>
                    <% hesap.ciktiToplamlari.forEach(function (c) { if (!c.var) return; %>
                      <th class="tablo-sayi"><%= c.norm.ad %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% hesap.kalemler.forEach(function (h) { %>
                    <tr>
                      <td><span class="fw-medium"><%= h.kalem.urun %></span><% if (h.kalem.cesit) { %> <span class="text-secondary">· <%= h.kalem.cesit %></span><% } %></td>
                      <% hesap.ciktiToplamlari.forEach(function (c, ci) { if (!c.var) return; var o = h.ciktilar[ci]; %>
                        <td class="tablo-sayi text-nowrap">
                          <% if (o.sonuc != null) { %>
                            <%= y.miktar(o.sonuc, o.birim) %>
                            <div class="text-secondary small"><%= y.sayi(o.deger) %> <%= o.normBirimi %></div>
                          <% } else { %><span class="text-secondary">–</span><% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot>
                  <tr class="fw-bold">
                    <td>Toplam</td>
                    <% hesap.ciktiToplamlari.forEach(function (c) { if (!c.var) return; %>
                      <td class="tablo-sayi text-nowrap"><%= toplamMetni(c.toplamlar) %></td>
                    <% }) %>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } %>
        </div>

        <!-- Çiftçi talepleri -->
        <%
          var to = talepOzeti;
          var hedefIlce = {};
          proje.ilceler.forEach(function (h) { hedefIlce[h.ilce] = h; });
          var ilceSatirlari = proje.ilceler.map(function (h) { return h.ilce; });
          to.ilceler.forEach(function (i) { if (ilceSatirlari.indexOf(i.ilce) < 0) ilceSatirlari.push(i.ilce); });
          var talepIlce = {};
          to.ilceler.forEach(function (i) { talepIlce[i.ilce] = i; });
          var oranMetni = function (a, b) { return b ? ' <span class="text-secondary small">%' + Math.round(100 * a / b) + '</span>' : ''; };
        %>
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title">Çiftçi talepleri</h3>
              <p class="card-subtitle"><%= to.ciftciSayisi %> çiftçi · <%= y.sayi(to.toplamAlan) %> da · çiftçi katkısı <%= y.para(to.ciftciKatkisi) %> <span class="text-secondary">(reddedilenler hariç)</span></p>
            </div>
            <div class="card-actions">
              <% if (izin('talep.gor')) { %><a href="/talepler?proje=<%= proje._id %>" class="btn btn-sm btn-ghost-secondary">Listele</a><% } %>
              <% if (izin('talep.gir')) { %><a href="/talepler/yeni?proje=<%= proje._id %>" class="btn btn-sm"><i class="ti ti-plus me-1"></i> Talep gir</a><% } %>
            </div>
          </div>
          <% if (!to.ciftciSayisi) { %>
            <div class="card-body text-secondary">Henüz çiftçi talebi girilmedi.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm table-vcenter card-table">
                <thead><tr><th>Kalem</th><th class="tablo-sayi">Çiftçi</th><th class="tablo-sayi">Talep alanı</th><th class="tablo-sayi">Dağıtılacak</th><th class="tablo-sayi">Bedel</th></tr></thead>
                <tbody>
                  <% to.kalemler.forEach(function (k) { if (!k.ciftci) return; var hk = hesap.kalemler.find(function (x) { return String(x.kalem._id) === String(k.kalem._id); }); %>
                    <tr>
                      <td><%= k.kalem.urun %><% if (k.kalem.cesit) { %> <span class="text-secondary">· <%= k.kalem.cesit %></span><% } %></td>
                      <td class="tablo-sayi"><%= k.ciftci %></td>
                      <td class="tablo-sayi text-nowrap"><%= y.sayi(k.alan) %> da<% if (hk && hk.alan) { %><%- oranMetni(k.alan, hk.alan) %><% } %></td>
                      <td class="tablo-sayi text-nowrap"><%= y.miktar(k.miktar, k.kalem.olcuBirimi) %><% if (k.teslim != null && k.teslimBirimi !== k.kalem.olcuBirimi) { %><div class="text-secondary small"><%= y.sayi(k.teslim) %> <%= k.teslimBirimi %></div><% } %></td>
                      <td class="tablo-sayi text-nowrap"><%= y.para(k.bedel) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="table-responsive border-top">
              <table class="table table-sm table-vcenter card-table">
                <thead><tr><th>İlçe</th><th class="tablo-sayi">Çiftçi (talep / hedef)</th><th class="tablo-sayi">Alan (talep / hedef)</th><th class="tablo-sayi">Çiftçi katkısı</th></tr></thead>
                <tbody>
                  <% ilceSatirlari.forEach(function (ilce) { var h = hedefIlce[ilce] || {}; var ti = talepIlce[ilce] || { ciftci: 0, alan: 0 }; %>
                    <tr>
                      <td><a href="/talepler?proje=<%= proje._id %>&ilce=<%= encodeURIComponent(ilce) %>" class="text-reset"><%= ilce %></a></td>
                      <td class="tablo-sayi text-nowrap"><%= ti.ciftci %> / <%= y.sayi(h.hedefCiftci) %></td>
                      <td class="tablo-sayi text-nowrap"><%= y.sayi(ti.alan) %> / <%= y.sayi(h.hedefDekar) %> da<% if (h.hedefDekar) { %><%- oranMetni(ti.alan, h.hedefDekar) %><% } %></td>
                      <td class="tablo-sayi text-nowrap"><%= y.para(ti.ciftciKatkisi) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <!-- Görevler -->
        <%
          var acikGorev = gorevler.filter(function (g) { return g.acik; }).length;
          var bitenGorev = gorevler.filter(function (g) { return g.durum === 'tamamlandi'; }).length;
        %>
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title">Görevler</h3>
              <p class="card-subtitle"><%= gorevler.length %> görev · <%= acikGorev %> açık · <%= bitenGorev %> tamamlandı</p>
            </div>
            <div class="card-actions">
              <% if (izin('gorev.ver')) { %><a href="/gorevler/yeni?proje=<%= proje._id %>&geri=/projeler/<%= proje._id %>" class="btn btn-sm"><i class="ti ti-plus me-1"></i> Görev ver</a><% } %>
            </div>
          </div>
          <% if (gorevler.length) { %>
            <%- include('../../../views/partials/gorev-tablosu', { gorevler: gorevler, geri: '/projeler/' + proje._id, projeGizle: true }) %>
          <% } else { %>
            <div class="card-body text-secondary">Bu projeye bağlı görev yok.</div>
          <% } %>
        </div>

        <% if (bilgiNormlari.length) { %>
          <div class="card mb-3">
            <div class="card-header"><h3 class="card-title">Diğer normlar</h3></div>
            <div class="table-responsive">
              <table class="table table-sm table-vcenter card-table">
                <thead>
                  <tr><th>Kalem</th><% bilgiNormlari.forEach(function (n) { %><th class="tablo-sayi"><%= n.ad %></th><% }) %></tr>
                </thead>
                <tbody>
                  <% proje.kalemler.forEach(function (k) { %>
                    <tr>
                      <td><%= k.urun %><% if (k.cesit) { %> <span class="text-secondary">· <%= k.cesit %></span><% } %></td>
                      <% bilgiNormlari.forEach(function (n) { var v = y.normOku(k.normlar, n.kod); %>
                        <td class="tablo-sayi"><%= v ? y.sayi(v.deger) + ' ' + (v.birim || n.birim) : '–' %></td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
