<tr>
  <td class="text-secondary">
    <span class="satir-no"></span>
    <% if (k._id) { %><input type="hidden" name="kalemler[<%= i %>][_id]" value="<%= k._id %>"><% } %>
  </td>
  <td>
    <select name="kalemler[<%= i %>][tur]" class="form-select" required>
      <option value="">Seçiniz</option>
      <% sabitler.kalemTurleri.forEach(function (t) { %>
        <option <%= k.tur === t ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
  </td>
  <td><input type="text" name="kalemler[<%= i %>][ad]" value="<%= k.ad || '' %>" class="form-control" placeholder="ör. Macar fiği + Arpa" required></td>
  <td>
    <select name="kalemler[<%= i %>][olcuBirimi]" class="form-select" required>
      <% sabitler.olcuBirimleri.forEach(function (b) { %>
        <option <%= (k.olcuBirimi || 'kg') === b ? 'selected' : '' %>><%= b %></option>
      <% }) %>
    </select>
  </td>
  <td><input type="number" step="any" min="0" name="kalemler[<%= i %>][dekarBasiMiktar]" value="<%= k.dekarBasiMiktar != null ? k.dekarBasiMiktar : '' %>" class="form-control text-end"></td>
  <td><input type="number" step="any" min="0" name="kalemler[<%= i %>][toplamMiktar]" value="<%= k.toplamMiktar != null ? k.toplamMiktar : '' %>" class="form-control text-end"></td>
  <td><input type="text" name="kalemler[<%= i %>][aciklama]" value="<%= k.aciklama || '' %>" class="form-control"></td>
  <td class="sil-sutunu">
    <button type="button" class="btn btn-ghost-danger btn-icon" data-satir-sil title="Kalemi kaldır"><i class="ti ti-trash"></i></button>
  </td>
</tr>
