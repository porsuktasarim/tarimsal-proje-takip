<%- include('../../../views/partials/ust') %>
<%
  var yeni = !proje._id;
  var kalemler = (proje.kalemler && proje.kalemler.length) ? proje.kalemler : [{}];
  var ilceHedefleri = {};
  (proje.ilceler || []).forEach(function (h) { ilceHedefleri[h.ilce] = h; });
%>
<%- include('../../../views/partials/sayfa-basligi', {
      ustBaslik: yeni ? 'Yeni proje' : proje.ad,
      eylemler: yeni ? '' : '<a href="/projeler/' + proje._id + '" class="btn btn-ghost-secondary">Vazgeç</a>'
    }) %>

<div class="page-body">
  <div class="container-xl">
    <% if (hatalar.length) { %>
      <div class="alert alert-danger" role="alert">
        <div class="alert-icon"><i class="ti ti-alert-circle"></i></div>
        <div>
          <h4 class="alert-heading">Kayıt yapılamadı</h4>
          <ul class="mb-0"><% hatalar.forEach(function (h) { %><li><%= h %></li><% }) %></ul>
        </div>
      </div>
    <% } %>

    <form method="post" action="<%= eylem %>" autocomplete="off">
      <!-- 1. Genel bilgiler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">1</span> Proje bilgileri</h3>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label required">Proje adı</label>
              <input type="text" name="ad" value="<%= proje.ad || '' %>" class="form-control" required
                     placeholder="ör. İstanbul Güzlük Yem Bitkileri Üretim Alanlarını Geliştirme Projesi">
            </div>
            <div class="col-md-6">
              <label class="form-label">Kısa ad</label>
              <input type="text" name="kisaAd" value="<%= proje.kisaAd || '' %>" class="form-control" placeholder="ör. Güzlük Yem Bitkileri 2026">
              <small class="form-hint">Listelerde ve raporlarda kullanılır.</small>
            </div>
            <div class="col-md-6">
              <label class="form-label required">Yürütücü birim</label>
              <select name="birim" class="form-select" required>
                <option value="">Seçiniz</option>
                <% sabitler.birimler.forEach(function (b) { %>
                  <option <%= proje.birim === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Dönem</label>
              <input type="text" name="donem" value="<%= proje.donem || '' %>" class="form-control" placeholder="ör. 2026 Güzlük">
            </div>
            <div class="col-md-4">
              <label class="form-label">Başlangıç tarihi</label>
              <input type="date" name="baslangicTarihi" value="<%= y.inputTarih(proje.baslangicTarihi) %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Bitiş tarihi</label>
              <input type="date" name="bitisTarihi" value="<%= y.inputTarih(proje.bitisTarihi) %>" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label">Açıklama</label>
              <textarea name="aciklama" rows="3" class="form-control" placeholder="Projenin amacı, dayanağı, kaynağı vb."><%= proje.aciklama || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Kalemler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">2</span> Kalemler</h3>
          <div class="card-actions">
            <button type="button" class="btn btn-sm" data-satir-ekle="kalemler"><i class="ti ti-plus me-1"></i> Kalem ekle</button>
          </div>
        </div>
        <div class="card-body pb-0">
          <p class="text-secondary mb-0">Projede dağıtılacak tohum, fide, gübre vb. her kalem ayrı satır olarak girilmelidir. Dekar başı miktar, çiftçiye verilecek miktarın hesabında kullanılır.</p>
        </div>
        <div class="table-responsive">
          <table class="table table-vcenter card-table satir-tablosu" data-satirlar="kalemler">
            <thead>
              <tr>
                <th>#</th>
                <th>Tür</th>
                <th>Kalem adı / çeşit</th>
                <th>Ölçü</th>
                <th class="text-end">Dekar başı</th>
                <th class="text-end">Toplam miktar</th>
                <th>Not</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% kalemler.forEach(function (k, i) { %>
                <%- include('kalem-satiri', { i: i, k: k }) %>
              <% }) %>
            </tbody>
          </table>
          <div class="satir-bos d-none text-secondary text-center py-3">Henüz kalem eklenmedi.</div>
        </div>
        <template id="kalemler-sablon"><%- include('kalem-satiri', { i: '__i__', k: {} }) %></template>
      </div>

      <!-- 3. İlçeler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">3</span> Uygulanacak ilçeler ve hedefler</h3>
          <div class="card-actions text-secondary"><span data-ilce-sayac>0</span> / <%= sabitler.ilceler.length %> ilçe seçili</div>
        </div>
        <div class="card-body pb-0">
          <p class="text-secondary mb-0">Projenin uygulanacağı ilçeler işaretlenmelidir. Hedef çiftçi sayısı ve dekar alanı bilinmiyorsa boş bırakılabilir; sonradan düzenlenebilir.</p>
        </div>
        <div class="table-responsive ilce-tablosu-kap mt-3">
          <table class="table table-sm table-vcenter card-table" data-ilce-tablosu>
            <thead>
              <tr>
                <th class="w-1"><input type="checkbox" class="form-check-input m-0" data-ilce-tumu title="Tümünü seç"></th>
                <th>İlçe</th>
                <th class="text-end">Hedef çiftçi</th>
                <th class="text-end">Hedef dekar</th>
              </tr>
            </thead>
            <tbody>
              <% sabitler.ilceler.forEach(function (ilce, i) { var h = ilceHedefleri[ilce]; %>
                <tr>
                  <td><input type="checkbox" class="form-check-input m-0 ilce-sec" name="ilceler[<%= i %>][ilce]" value="<%= ilce %>" id="ilce-<%= i %>" <%= h ? 'checked' : '' %>></td>
                  <td><label for="ilce-<%= i %>" class="mb-0"><%= ilce %></label></td>
                  <td style="width:10rem"><input type="number" min="0" step="1" name="ilceler[<%= i %>][hedefCiftci]" value="<%= h && h.hedefCiftci != null ? h.hedefCiftci : '' %>" class="form-control form-control-sm text-end"></td>
                  <td style="width:10rem"><input type="number" min="0" step="any" name="ilceler[<%= i %>][hedefDekar]" value="<%= h && h.hedefDekar != null ? h.hedefDekar : '' %>" class="form-control form-control-sm text-end"></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2 mb-4">
        <a href="<%= yeni ? '/projeler' : '/projeler/' + proje._id %>" class="btn btn-ghost-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-device-floppy me-1"></i> <%= yeni ? 'Projeyi başlat' : 'Değişiklikleri kaydet' %>
        </button>
      </div>
    </form>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
