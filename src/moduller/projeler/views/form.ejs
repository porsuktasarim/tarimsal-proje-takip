<%- include('../../../views/partials/ust') %>
<%
  var yeni = !proje._id;
  var kalemler = (proje.kalemler && proje.kalemler.length) ? proje.kalemler : [{}];
  var ilceHedefleri = {};
  (proje.ilceler || []).forEach(function (h) { ilceHedefleri[h.ilce] = h; });

  // Ayarlardan kaldırılmış ama projede kayıtlı değerler de seçenek olarak kalır.
  var ekle = function (liste, deger) { var l = liste.slice(); if (deger && l.indexOf(deger) < 0) l.push(deger); return l; };
  var birimler = ekle(ayar.birimler, proje.birim);
  var donemler = ekle(ayar.donemAdlari, proje.donem);
  var ilceler = ayar.ilceler.slice();
  (proje.ilceler || []).forEach(function (h) { if (ilceler.indexOf(h.ilce) < 0) ilceler.push(h.ilce); });
  var turler = ayar.kalemTurleri.slice();
  var olculer = ayar.olcuBirimleri.slice();

  var istemciVerisi = {
    turler: turler,
    ekimKod: ayar.ekimNormu ? ayar.ekimNormu.kod : null,
    normsuzTurler: ayar.normsuzTurler || [],
    urunler: katalog
  };
%>
<%- include('../../../views/partials/sayfa-basligi', {
      ustBaslik: yeni ? 'Yeni proje' : proje.ad,
      eylemler: yeni ? '' : '<a href="/projeler/' + proje._id + '" class="btn btn-ghost-secondary">Vazgeç</a>'
    }) %>

<div class="page-body">
  <div class="container-xl">
    <%- include('../../../views/partials/hatalar') %>

    <form method="post" action="<%= eylem %>" autocomplete="off" id="proje-formu">
      <!-- 1. Genel bilgiler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">1</span> Proje bilgileri</h3>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label required">Proje adı</label>
              <input type="text" name="ad" value="<%= proje.ad || '' %>" class="form-control" required
                     placeholder="ör. İstanbul Güzlük Yem Bitkileri Üretim Alanlarını Geliştirme Projesi">
            </div>
            <div class="col-md-6">
              <label class="form-label">Kısa ad</label>
              <input type="text" name="kisaAd" value="<%= proje.kisaAd || '' %>" class="form-control" placeholder="ör. Güzlük Yem Bitkileri 2026">
              <small class="form-hint">Listelerde ve raporlarda kullanılır.</small>
            </div>
            <div class="col-md-6">
              <label class="form-label required">Yürütücü birim</label>
              <select name="birim" class="form-select" required>
                <option value="">Seçiniz</option>
                <% birimler.forEach(function (b) { %>
                  <option <%= proje.birim === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
              <small class="form-hint">Liste <a href="/ayarlar/birimler">Ayarlar</a>'dan yönetilir.</small>
            </div>
            <div class="col-md-4">
              <label class="form-label">Dönem</label>
              <select name="donem" class="form-select">
                <option value="">Seçiniz</option>
                <% donemler.forEach(function (d) { %>
                  <option <%= proje.donem === d ? 'selected' : '' %>><%= d %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Başlangıç tarihi</label>
              <input type="date" name="baslangicTarihi" value="<%= y.inputTarih(proje.baslangicTarihi) %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Bitiş tarihi</label>
              <input type="date" name="bitisTarihi" value="<%= y.inputTarih(proje.bitisTarihi) %>" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label">Açıklama</label>
              <textarea name="aciklama" rows="3" class="form-control" placeholder="Projenin amacı, dayanağı, kaynağı vb."><%= proje.aciklama || '' %></textarea>
            </div>
            <div class="col-12"><div class="hr-text my-2">Finansman ve başvuru</div></div>
            <% var fin = proje.finansman || {}; var bas = proje.basvuru || {}; %>
            <div class="col-md-4">
              <label class="form-label">Destek kaynağı</label>
              <input type="text" name="finansman[destekKaynagi]" value="<%= fin.destekKaynagi || '' %>" class="form-control" placeholder="ör. İstanbul Valiliği">
            </div>
            <div class="col-md-2">
              <label class="form-label">Çiftçi katkısı</label>
              <div class="input-group">
                <span class="input-group-text">%</span>
                <input type="number" step="any" min="0" max="100" name="finansman[ciftciKatkiOrani]" value="<%= fin.ciftciKatkiOrani != null ? fin.ciftciKatkiOrani : '' %>" class="form-control text-end" placeholder="25">
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Öncelikli alan sınırı</label>
              <div class="input-group">
                <input type="number" step="any" min="0" name="basvuru[oncelikliAlan]" value="<%= bas.oncelikliAlan != null ? bas.oncelikliAlan : '' %>" class="form-control text-end" placeholder="50">
                <span class="input-group-text">da</span>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Azami alan</label>
              <div class="input-group">
                <input type="number" step="any" min="0" name="basvuru[azamiAlan]" value="<%= bas.azamiAlan != null ? bas.azamiAlan : '' %>" class="form-control text-end" placeholder="100">
                <span class="input-group-text">da</span>
              </div>
            </div>
            <div class="col-12">
              <small class="form-hint">Kalem bedellerinin çiftçi katkı oranı kadarı çiftçiden, kalanı destek kaynağından karşılanır. Alan sınırları çiftçi talebi girilirken uyarı olarak gösterilir.</small>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Kalemler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">2</span> Kalemler</h3>
          <div class="card-actions">
            <button type="button" class="btn btn-sm" data-satir-ekle="kalemler"><i class="ti ti-plus me-1"></i> Kalem ekle</button>
          </div>
        </div>
        <div class="card-body">
          <p class="text-secondary">
            Katalogdan seçilen ürün ve çeşidin normları, birimleri ve ambalaj içeriği kendiliğinden dolar; hepsi proje içinde değiştirilebilir.
            Katalogda olmayan bir ürün ya da çeşit yazılırsa proje kaydedilince <a href="/ayarlar/urunler">Ürün kataloğu</a>na eklenir.
            Toplam dağıtım boş bırakılırsa alan × ekim normu olarak hesaplanır; dağıtım birimi torba, çuval gibi bir ambalajsa ambalaj içeriğine bölünür.
            Alan boş bırakılır ve projede tek kalem varsa ilçe hedeflerinin toplam dekarı kullanılır.
          </p>
          <div data-satirlar="kalemler" class="kalem-listesi">
            <% kalemler.forEach(function (k, i) { %>
              <%- include('kalem-blok', { i: i, u: 's' + i, k: k, turler: turler, olculer: olculer }) %>
            <% }) %>
          </div>
          <div class="d-none text-secondary text-center py-3" data-satir-bos="kalemler">Henüz kalem eklenmedi.</div>
        </div>
        <template id="kalemler-sablon"><%- include('kalem-blok', { i: '__i__', u: '__u__', k: {}, turler: turler, olculer: olculer }) %></template>
        <% turler.forEach(function (t, ti) { %>
          <datalist id="dl-urun-<%= ti %>">
            <% katalog.filter(function (u) { return u.tur === t; }).forEach(function (u) { %><option value="<%= u.ad %>"></option><% }) %>
          </datalist>
        <% }) %>
        <script type="application/json" id="urun-katalogu"><%- JSON.stringify(istemciVerisi).replace(/</g, '\\u003c') %></script>
      </div>

      <!-- 3. İlçeler -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">3</span> Uygulanacak ilçeler ve hedefler</h3>
          <div class="card-actions text-secondary"><span data-ilce-sayac>0</span> / <%= ilceler.length %> ilçe seçili</div>
        </div>
        <div class="card-body pb-0">
          <p class="text-secondary mb-0">Projenin uygulanacağı ilçeler işaretlenmelidir. Hedef çiftçi sayısı ve dekar alanı bilinmiyorsa boş bırakılabilir; sonradan düzenlenebilir.</p>
        </div>
        <div class="table-responsive ilce-tablosu-kap mt-3">
          <table class="table table-sm table-vcenter card-table" data-ilce-tablosu>
            <thead>
              <tr>
                <th class="w-1"><input type="checkbox" class="form-check-input m-0" data-ilce-tumu title="Tümünü seç"></th>
                <th>İlçe</th>
                <th class="text-end">Hedef çiftçi</th>
                <th class="text-end">Hedef dekar</th>
              </tr>
            </thead>
            <tbody>
              <% ilceler.forEach(function (ilce, i) { var h = ilceHedefleri[ilce]; %>
                <tr>
                  <td><input type="checkbox" class="form-check-input m-0 ilce-sec" name="ilceler[<%= i %>][ilce]" value="<%= ilce %>" id="ilce-<%= i %>" <%= h ? 'checked' : '' %>></td>
                  <td><label for="ilce-<%= i %>" class="mb-0"><%= ilce %></label></td>
                  <td style="width:10rem"><input type="number" min="0" step="1" name="ilceler[<%= i %>][hedefCiftci]" value="<%= h && h.hedefCiftci != null ? h.hedefCiftci : '' %>" class="form-control form-control-sm text-end"></td>
                  <td style="width:10rem"><input type="number" min="0" step="any" name="ilceler[<%= i %>][hedefDekar]" value="<%= h && h.hedefDekar != null ? h.hedefDekar : '' %>" class="form-control form-control-sm text-end"></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 4. Proje ekibi -->
      <%
        var secKoor = (proje.koordinatorler || []).map(String);
        var secYur = (proje.yurutuculer || []).map(String);
        // Her listede aktif kişiler ile projede kayıtlı pasif kişiler; önerilen rol önce gelir
        var ekipListesi = function (oncelikliRol, secili) {
          return kisiler
            .filter(function (k) { return k.aktif || secili.indexOf(String(k._id)) >= 0; })
            .sort(function (a, b) { return (a.rol === oncelikliRol ? 0 : 1) - (b.rol === oncelikliRol ? 0 : 1) || a.adSoyad.localeCompare(b.adSoyad, 'tr'); });
        };
      %>
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title"><span class="badge bg-primary-lt me-2">4</span> Proje ekibi</h3>
        </div>
        <div class="card-body">
          <div class="row g-4">
            <% [['Proje koordinatörleri', 'koordinator', 'koordinatorler', secKoor], ['Proje yürütücüleri', 'yurutucu', 'yurutuculer', secYur]].forEach(function (g) {
                 var liste = ekipListesi(g[1], g[3]); %>
              <div class="col-md-6">
                <div class="form-label"><%= g[0] %></div>
                <% if (!liste.length) { %>
                  <div class="text-secondary small">Kişi tanımlı değil. <a href="/ayarlar/kisiler/yeni">Kişi ekle</a></div>
                <% } %>
                <div class="ekip-listesi">
                  <% liste.forEach(function (k, i) { %>
                    <label class="form-check">
                      <input type="checkbox" class="form-check-input" name="<%= g[2] %>[<%= i %>]" value="<%= k._id %>" <%= g[3].indexOf(String(k._id)) >= 0 ? 'checked' : '' %>>
                      <span class="form-check-label">
                        <%= k.adSoyad %>
                        <span class="badge bg-<%= ayar.rolRenk[k.rol] || 'secondary' %>-lt ms-1"><%= ayar.rolAdlari[k.rol] || k.rol %></span>
                        <% if (!k.aktif) { %><span class="badge bg-secondary-lt">Pasif</span><% } %>
                        <% if (k.ilceler && k.ilceler.length) { %><span class="text-secondary small"> · <%= k.ilceler.join(', ') %></span><% } %>
                      </span>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <%
        var dgr = proje.degerlendirme || {};
        var formuller = (dgr.formuller && dgr.formuller.length) ? dgr.formuller : [];
        var limitler = (dgr.limitler && dgr.limitler.length) ? dgr.limitler : [];
        var dv = function (v) { return v !== undefined && v !== null ? v : ''; };
        var formulSatiri = function (i, f) {
          return '<tr>' +
            '<td><input type="text" name="formuller[' + i + '][ad]" value="' + y.kacis(dv(f.ad)) + '" class="form-control form-control-sm formul-ad" placeholder="ör. Ot ihtiyacı">' +
            '<div class="small text-secondary font-monospace formul-kod">' + y.kacis(dv(f.kod)) + '</div></td>' +
            '<td><input type="text" name="formuller[' + i + '][ifade]" value="' + y.kacis(dv(f.ifade)) + '" class="form-control form-control-sm font-monospace formul-ifade" placeholder="buyukbas * 3650 + kucukbas * 550"></td>' +
            '<td><input type="text" name="formuller[' + i + '][birim]" value="' + y.kacis(dv(f.birim)) + '" class="form-control form-control-sm" placeholder="kg"></td>' +
            '<td><input type="number" min="0" max="6" name="formuller[' + i + '][ondalik]" value="' + dv(f.ondalik) + '" class="form-control form-control-sm text-end" placeholder="2"></td>' +
            '<td class="text-center"><input type="checkbox" class="form-check-input formul-puan" name="formuller[' + i + '][puan]" value="1"' + (f.puan ? ' checked' : '') + '></td>' +
            '<td class="sil-sutunu"><button type="button" class="btn btn-ghost-danger btn-icon btn-sm" data-satir-sil title="Kaldır"><i class="ti ti-trash"></i></button></td></tr>';
        };
        var limitSatiri = function (i, l) {
          return '<tr>' +
            '<td><input type="text" name="limitler[' + i + '][ad]" value="' + y.kacis(dv(l.ad)) + '" class="form-control form-control-sm" placeholder="ör. Azami destek tutarı"></td>' +
            '<td><input type="text" name="limitler[' + i + '][ifade]" value="' + y.kacis(dv(l.ifade)) + '" class="form-control form-control-sm font-monospace formul-ifade" list="dl-degiskenler" placeholder="destek"></td>' +
            '<td class="text-center text-secondary">≤</td>' +
            '<td><input type="number" step="any" name="limitler[' + i + '][ust]" value="' + dv(l.ust) + '" class="form-control form-control-sm text-end" placeholder="20000"></td>' +
            '<td><input type="text" name="limitler[' + i + '][birim]" value="' + y.kacis(dv(l.birim)) + '" class="form-control form-control-sm" placeholder="TL"></td>' +
            '<td class="sil-sutunu"><button type="button" class="btn btn-ghost-danger btn-icon btn-sm" data-satir-sil title="Kaldır"><i class="ti ti-trash"></i></button></td></tr>';
        };
        var gruplar = [];
        degiskenler.forEach(function (d) { var g = gruplar.find(function (x) { return x.ad === d.grup; }); if (!g) { g = { ad: d.grup, liste: [] }; gruplar.push(g); } g.liste.push(d); });
      %>
      <div class="card mb-3">
        <div class="card-header">
          <div>
            <h3 class="card-title"><span class="badge bg-primary-lt me-2">5</span> Başvuru değerlendirmesi</h3>
            <p class="card-subtitle">Değerlendirme sayfasında her başvuru için hesaplanacak değerler ve üst limitler. İsteğe bağlıdır.</p>
          </div>
        </div>
        <div class="card-body">
          <div class="d-flex align-items-center mb-2">
            <h4 class="mb-0">Formüller</h4>
            <button type="button" class="btn btn-sm ms-auto" data-satir-ekle="formuller"><i class="ti ti-plus me-1"></i> Formül ekle</button>
          </div>
          <p class="text-secondary small mb-2">Her formül listede bir sütun olur; sırayla hesaplanır ve kendinden önceki formülleri adıyla kullanabilir (ör. <code>ot_acigi = ot_ihtiyaci - kuru_ot_uretimi</code>). "Puan" işaretlenen formüle göre başvurular sıralanır.</p>
          <div class="table-responsive">
            <table class="table table-sm table-vcenter satir-tablosu mb-2">
              <thead><tr><th style="width:18%">Ad</th><th>Formül</th><th style="width:8%">Birim</th><th style="width:7%">Ondalık</th><th class="w-1">Puan</th><th class="w-1"></th></tr></thead>
              <tbody data-satirlar="formuller"><% formuller.forEach(function (f, i) { %><%- formulSatiri(i, f) %><% }) %></tbody>
            </table>
            <div class="d-none text-secondary small py-2" data-satir-bos="formuller">Formül tanımlanmadı.</div>
          </div>
          <template id="formuller-sablon"><%- formulSatiri('__i__', {}) %></template>

          <div class="d-flex align-items-center mb-2 mt-4">
            <h4 class="mb-0">Üst limitler</h4>
            <button type="button" class="btn btn-sm ms-auto" data-satir-ekle="limitler"><i class="ti ti-plus me-1"></i> Limit ekle</button>
          </div>
          <p class="text-secondary small mb-2">Bir değişkenin ya da formülün üst sınırı: maddi (<code>destek</code>, <code>bedel</code>), tohum miktarı (<code>yulaf_teslim</code>), alan (<code>toplam_da</code>)… Aşan başvurular listede işaretlenir; miktar kendiliğinden değişmez.</p>
          <div class="table-responsive">
            <table class="table table-sm table-vcenter satir-tablosu mb-2">
              <thead><tr><th style="width:25%">Ad</th><th>Ölçüt (değişken ya da formül)</th><th class="w-1"></th><th style="width:14%">Üst değer</th><th style="width:9%">Birim</th><th class="w-1"></th></tr></thead>
              <tbody data-satirlar="limitler"><% limitler.forEach(function (l, i) { %><%- limitSatiri(i, l) %><% }) %></tbody>
            </table>
            <div class="d-none text-secondary small py-2" data-satir-bos="limitler">Limit tanımlanmadı.</div>
          </div>
          <template id="limitler-sablon"><%- limitSatiri('__i__', {}) %></template>

          <details class="mt-3">
            <summary class="text-primary">Kullanılabilir değişkenler ve işlevler</summary>
            <div class="mt-2 small">
              <% gruplar.forEach(function (g) { %>
                <div class="mb-2"><span class="text-secondary me-1"><%= g.ad %>:</span>
                  <% g.liste.forEach(function (d) { %><button type="button" class="btn btn-sm btn-ghost-secondary px-1 py-0 font-monospace" data-degisken="<%= d.ad %>" title="<%= d.aciklama %><%= d.birim ? ' (' + d.birim + ')' : '' %>"><%= d.ad %></button> <% }) %>
                </div>
              <% }) %>
              <div class="text-secondary">Kalem değişkenleri ürün ve çeşit adından üretilir (Mısır ADA → <code>misir_ada_talep</code>); yeni eklenen kalemlerin değişkenleri proje kaydedilince listelenir.
                İşlemler: <code>+ - * / ^ ( )</code>, karşılaştırma <code>&lt; &lt;= &gt; &gt;= == !=</code> (doğru 1, yanlış 0), <code>ve</code> <code>veya</code> <code>değil</code>.
                İşlevler: <code>min(a; b)</code> <code>max(a; b)</code> <code>yuvarla(x; 2)</code> <code>yukari(x)</code> <code>asagi(x)</code> <code>mutlak(x)</code> <code>karekok(x)</code> <code>eger(koşul; doğruysa; yanlışsa)</code>.
                Örnek puan: <code>cks * 10 + min(buyukbas; 50) + eger(toplam_da &lt;= 50; 20; 0)</code></div>
            </div>
            <datalist id="dl-degiskenler"><% degiskenler.forEach(function (d) { %><option value="<%= d.ad %>"><%= d.aciklama %></option><% }) %><% formuller.forEach(function (f) { %><option value="<%= f.kod %>"><%= f.ad %></option><% }) %></datalist>
          </details>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2 mb-4">
        <a href="<%= yeni ? '/projeler' : '/projeler/' + proje._id %>" class="btn btn-ghost-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-device-floppy me-1"></i> <%= yeni ? 'Projeyi başlat' : 'Değişiklikleri kaydet' %>
        </button>
      </div>
    </form>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
