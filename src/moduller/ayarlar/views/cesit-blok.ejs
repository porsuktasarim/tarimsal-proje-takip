<%
  // Parametreler: i, c (çeşit), unormlar (ürünün normları), uambalaj, olcu
  var on = 'cesitler[' + i + ']';
  var cn = c.normlar || {};
  var ua = uambalaj || {};
%>
<div class="kalem-blok" data-satir>
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label small mb-1">Çeşit adı</label>
      <input type="hidden" name="<%= on %>[eski]" value="<%= c.eski || '' %>">
      <input type="text" name="<%= on %>[ad]" value="<%= c.ad || '' %>" class="form-control form-control-sm" placeholder="ör. ADA">
    </div>
    <div class="col-md-5">
      <label class="form-label small mb-1">Ambalaj içeriği (farklıysa)</label>
      <%- include('../../../views/partials/ambalaj-girdi', {
            onek: on + '[ambalaj]', a: c.ambalaj, ytMiktar: ua.miktar, ytBirim: ua.birim, etiket: '1 ' + (olcu || 'ambalaj') + ' ='
          }) %>
    </div>
    <div class="col-md-3 text-end">
      <button type="button" class="btn btn-ghost-danger btn-sm" data-satir-sil><i class="ti ti-trash me-1"></i> Çeşidi kaldır</button>
    </div>
  </div>
  <div class="row g-2 mt-1">
    <% ayar.normlar.forEach(function (n) { var v = cn[n.kod] || {}; var u = unormlar[n.kod] || {}; %>
      <%- include('../../../views/partials/norm-girdi', {
            onek: on + '[normlar]', n: n, deger: v.deger, birim: v.deger != null ? v.birim : '',
            ytDeger: u.deger, ytBirim: u.birim || n.birim, kolon: 'col-6 col-md-4 col-xl-3'
          }) %>
    <% }) %>
  </div>
</div>
