<%
  // Parametreler: i, r (rol), kullanim ({ kisi, gorev } ya da boş)
  var on = 'roller[' + i + ']';
  var admin = r.kod === 'admin';
  var k = kullanim || { kisi: 0, gorev: 0 };
  var secili = r.yetkiler || [];
  var silinemez = admin || k.kisi > 0 || k.gorev > 0;
%>
<div class="kalem-blok rol-blok" data-satir>
  <input type="hidden" name="<%= on %>[kod]" value="<%= r.kod || '' %>">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label small mb-1">Rol adı</label>
      <div class="input-group input-group-sm">
        <span class="input-group-text"><span class="badge bg-<%= r.renk || 'secondary' %> p-1 rol-renk-onizleme"></span></span>
        <input type="text" name="<%= on %>[ad]" value="<%= r.ad || '' %>" class="form-control" required placeholder="ör. İlçe Müdürü">
      </div>
    </div>
    <div class="col-md-5">
      <label class="form-label small mb-1">Açıklama</label>
      <input type="text" name="<%= on %>[aciklama]" value="<%= r.aciklama || '' %>" class="form-control form-control-sm">
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small mb-1">Renk</label>
      <select name="<%= on %>[renk]" class="form-select form-select-sm rol-renk">
        <% rolRenkSecenekleri.forEach(function (c) { %><option value="<%= c %>" <%= (r.renk || 'secondary') === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
    </div>
    <div class="col-6 col-md-1 text-end">
      <% if (!silinemez) { %>
        <button type="button" class="btn btn-ghost-danger btn-icon btn-sm" data-satir-sil title="Rolü kaldır"><i class="ti ti-trash"></i></button>
      <% } %>
    </div>
  </div>
  <div class="small text-secondary mt-1">
    <% if (r.kod) { %><%= k.kisi %> kişi<% if (k.gorev) { %> · <%= k.gorev %> görev<% } %><% if (!admin && (k.kisi || k.gorev)) { %> · kullanımda olduğu için silinemez<% } %><% } else { %><span class="badge bg-green-lt">Yeni rol</span><% } %>
  </div>

  <% if (admin) { %>
    <div class="mt-3 text-secondary"><i class="ti ti-shield-check text-green me-1"></i> Tüm yetkilere sahiptir; tek kişiye verilir. Yetkileri değiştirilemez.</div>
  <% } else { %>
    <div class="row g-3 mt-1">
      <% yetkiGruplari.forEach(function (g) { %>
        <div class="col-md-6 col-xl-3">
          <div class="subheader mb-1"><%= g.ad %></div>
          <% g.yetkiler.forEach(function (y) { %>
            <label class="form-check mb-1">
              <input type="checkbox" class="form-check-input" name="<%= on %>[yetkiler][]" value="<%= y.kod %>" <%= secili.indexOf(y.kod) >= 0 ? 'checked' : '' %>>
              <span class="form-check-label small"><%= y.ad %></span>
            </label>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <label class="form-check form-switch mt-2 mb-0">
      <input type="checkbox" class="form-check-input" name="<%= on %>[ilceKisitli]" <%= r.ilceKisitli ? 'checked' : '' %>>
      <span class="form-check-label">İlçe kısıtlı <span class="text-secondary small">(kişi yalnızca sorumlu olduğu ilçelerin çiftçisini ve talebini girer)</span></span>
    </label>
  <% } %>
</div>
