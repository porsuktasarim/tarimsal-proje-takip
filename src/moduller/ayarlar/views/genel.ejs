<%- include('_bas') %>
<form method="post" action="/ayarlar/genel" class="card" enctype="multipart/form-data">
  <div class="card-header">
    <div>
      <h3 class="card-title">Genel</h3>
      <p class="card-subtitle">Ekranlarda, raporlarda ve tutanaklarda kullanılacak kurum bilgileri.</p>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label required">Kurum adı</label>
        <input type="text" name="kurum" value="<%= deger.kurum || '' %>" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label required">İl</label>
        <input type="text" name="il" value="<%= deger.il || '' %>" class="form-control" required>
      </div>
      <div class="col-12"><div class="hr-text my-1">Kurum logosu</div>
        <div class="small text-secondary">Proje izleme formunun ve il müdürlüğü yazılarının başında yer alır; tüm projelerde kullanılır. PNG ya da JPEG, en çok 3 MB.</div></div>
      <div class="col-md-3 text-center">
        <% if (deger.logoDosyaId) { %>
          <img src="/ayarlar/logo?v=<%= deger.logoDosyaId %>" alt="Kurum logosu" style="max-width: 100%; max-height: 96px">
          <label class="form-check mt-2 small"><input type="checkbox" class="form-check-input" name="logoSil"><span class="form-check-label">Logoyu kaldır</span></label>
        <% } else { %>
          <div class="border rounded text-secondary small p-4">Logo yok</div>
        <% } %>
      </div>
      <div class="col-md-9">
        <label class="form-label"><%= deger.logoDosyaId ? 'Logoyu değiştir' : 'Logo yükle' %></label>
        <input type="file" name="logo" accept="image/png,image/jpeg" class="form-control mb-2">
        <label class="form-label">Logonun yanındaki yazı</label>
        <textarea name="logoUstMetin" rows="2" class="form-control" placeholder="T.C. Tarım ve Orman Bakanlığı&#10;Bitkisel Üretim Genel Müdürlüğü"><%= deger.logoUstMetin || '' %></textarea>
        <small class="form-hint">Boş bırakılırsa "T.C. Tarım ve Orman Bakanlığı / Bitkisel Üretim Genel Müdürlüğü" yazılır.</small>
      </div>
      <% var kh = deger.katkiHesabi || {}; %>
      <div class="col-12"><div class="hr-text my-1">Üretici katkı payı hesabı (varsayılan)</div>
        <div class="small text-secondary">Katkı payı dilekçelerinde ve ödeme yazısında yazılır. Projenin Formlar bölümünde başka hesap girilirse o proje için o geçer.</div></div>
      <div class="col-md-6">
        <label class="form-label">Banka / şube</label>
        <input type="text" name="katkiHesabi[banka]" value="<%= kh.banka || '' %>" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label">Alıcı adı</label>
        <input type="text" name="katkiHesabi[alici]" value="<%= kh.alici || '' %>" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label">IBAN</label>
        <input type="text" name="katkiHesabi[iban]" value="<%= kh.iban || '' %>" class="form-control font-monospace" placeholder="TR.. .... .... .... .... .... ..">
      </div>
    </div>
  </div>
  <div class="card-footer text-end">
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
  </div>
</form>
<%- include('_son') %>
