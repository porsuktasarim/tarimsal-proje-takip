<%- include('_bas') %>
<form method="post" action="/ayarlar/genel" class="card">
  <div class="card-header">
    <div>
      <h3 class="card-title">Genel</h3>
      <p class="card-subtitle">Ekranlarda, raporlarda ve tutanaklarda kullanılacak kurum bilgileri.</p>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label required">Kurum adı</label>
        <input type="text" name="kurum" value="<%= deger.kurum || '' %>" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label required">İl</label>
        <input type="text" name="il" value="<%= deger.il || '' %>" class="form-control" required>
      </div>
    </div>
  </div>
  <div class="card-footer text-end">
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
  </div>
</form>
<%- include('_son') %>
