<%- include('../../../views/partials/ust') %>
<%- include('../../../views/partials/sayfa-basligi', {
      ustBaslik: 'Ayarlar',
      eylemler: typeof eylemler !== 'undefined' ? eylemler : ''
    }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row g-3">
      <div class="col-lg-3">
        <div class="card">
          <div class="list-group list-group-flush ayar-menu">
            <% sekmeler.forEach(function (s) { %>
              <a href="<%= s.yol %>" class="list-group-item list-group-item-action d-flex align-items-center<%= aktifSekme === s.yol ? ' active' : '' %>">
                <i class="ti <%= s.ikon %> me-2"></i><%= s.ad %>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-9"<%= silebilir ? "" : " data-silme-kapali" %>>
        <%- include('../../../views/partials/bildirim') %>
        <%- include('../../../views/partials/hatalar') %>
