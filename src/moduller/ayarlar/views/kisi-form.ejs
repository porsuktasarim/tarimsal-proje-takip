<%- include('_bas') %>
<%
  var yeni = !kisi._id;
  var birimler = ayar.birimler.slice();
  if (kisi.birim && birimler.indexOf(kisi.birim) < 0) birimler.push(kisi.birim);
  var secIlceler = kisi.ilceler || [];
%>
<form method="post" action="<%= eylem %>" class="card" autocomplete="off">
  <div class="card-header">
    <h3 class="card-title"><%= yeni ? 'Yeni kişi' : kisi.adSoyad %></h3>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label required">Ad soyad</label>
        <input type="text" name="adSoyad" value="<%= kisi.adSoyad || '' %>" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Unvan</label>
        <input type="text" name="unvan" value="<%= kisi.unvan || '' %>" class="form-control" placeholder="ör. Ziraat Mühendisi">
      </div>
      <div class="col-md-6">
        <label class="form-label required">Rol</label>
        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
          <% ayar.roller.forEach(function (r) { %>
            <label class="form-selectgroup-item flex-fill">
              <input type="radio" name="rol" value="<%= r.kod %>" class="form-selectgroup-input" <%= kisi.rol === r.kod ? 'checked' : '' %> required>
              <div class="form-selectgroup-label d-flex align-items-center p-2">
                <span class="me-2"><span class="form-selectgroup-check"></span></span>
                <span class="form-selectgroup-label-content">
                  <span class="fw-medium d-block text-start"><%= r.ad %></span>
                  <span class="d-block text-secondary small text-start"><%= r.aciklama %></span>
                </span>
              </div>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="col-md-6">
        <label class="form-label">Birim</label>
        <select name="birim" class="form-select mb-3">
          <option value="">–</option>
          <% birimler.forEach(function (b) { %><option <%= kisi.birim === b ? 'selected' : '' %>><%= b %></option><% }) %>
        </select>
        <label class="form-label">Telefon</label>
        <input type="tel" name="telefon" value="<%= kisi.telefon || '' %>" class="form-control mb-3">
        <label class="form-label">E-posta</label>
        <input type="email" name="eposta" value="<%= kisi.eposta || '' %>" class="form-control">
      </div>
      <div class="col-12">
        <label class="form-label">Sorumlu olduğu ilçeler <span class="text-secondary fw-normal">(özellikle yürütücüler için)</span></label>
        <div class="ilce-secim">
          <% ayar.ilceler.forEach(function (ilce, i) { %>
            <label class="form-check form-check-inline mb-1">
              <input type="checkbox" class="form-check-input" name="ilceler[<%= i %>]" value="<%= ilce %>" <%= secIlceler.indexOf(ilce) >= 0 ? 'checked' : '' %>>
              <span class="form-check-label"><%= ilce %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label">Not</label>
        <textarea name="aciklama" rows="2" class="form-control"><%= kisi.aciklama || '' %></textarea>
      </div>
      <div class="col-12">
        <label class="form-check form-switch">
          <input type="checkbox" class="form-check-input" name="aktif" <%= kisi.aktif !== false ? 'checked' : '' %>>
          <span class="form-check-label">Aktif <span class="text-secondary">(pasif kişiler giriş ekranında ve seçim listelerinde görünmez)</span></span>
        </label>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex align-items-center gap-2">
    <% if (!yeni) { %>
      <% if (kullanim > 0) { %>
        <span class="text-secondary small me-auto"><i class="ti ti-info-circle"></i> <%= kullanim %> proje/görev kaydında geçiyor; silinemez, pasif yapılabilir.</span>
      <% } else { %>
        <button type="submit" formaction="/ayarlar/kisiler/<%= kisi._id %>/sil" formnovalidate class="btn btn-ghost-danger me-auto"
                data-onay-dugme="Bu kişi silinecek. Devam edilsin mi?"><i class="ti ti-trash me-1"></i> Sil</button>
      <% } %>
    <% } %>
    <a href="/ayarlar/kisiler" class="btn btn-ghost-secondary<%= yeni ? ' ms-auto' : '' %>">Vazgeç</a>
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
  </div>
</form>
<%- include('_son') %>
