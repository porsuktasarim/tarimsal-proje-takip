<%- include('_bas') %>
<form method="post" action="/ayarlar/hayvan-turleri" class="card" autocomplete="off">
  <div class="card-header">
    <div>
      <h3 class="card-title">Hayvan türleri</h3>
      <p class="card-subtitle">Çiftçi talebi girilirken işletmedeki hayvan varlığı bu türlerle sorulur. Talebin değerlendirilmesinde yardımcı bilgidir, hesaba girmez.</p>
    </div>
    <div class="card-actions">
      <button type="button" class="btn btn-sm" data-satir-ekle="satirlar"><i class="ti ti-plus me-1"></i> Tür ekle</button>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-vcenter card-table satir-tablosu">
      <thead><tr><th class="w-1">#</th><th>Tür</th><th style="width:10rem">Birim</th><th class="w-1 text-nowrap">Kullanım</th><th class="w-1"></th></tr></thead>
      <tbody data-satirlar="satirlar">
        <% satirlar.forEach(function (s, i) { var n = (s.kod && kullanim[s.kod]) || 0; %>
          <tr>
            <td class="text-secondary"><span class="satir-no"></span></td>
            <td>
              <input type="hidden" name="satirlar[<%= i %>][kod]" value="<%= s.kod || '' %>">
              <input type="text" name="satirlar[<%= i %>][ad]" value="<%= s.ad || '' %>" class="form-control">
            </td>
            <td><input type="text" name="satirlar[<%= i %>][birim]" value="<%= s.birim || '' %>" class="form-control" placeholder="baş"></td>
            <td class="text-nowrap"><% if (n) { %><span class="badge bg-blue-lt"><%= n %> talep</span><% } else { %><span class="text-secondary">–</span><% } %></td>
            <td class="sil-sutunu"><button type="button" class="btn btn-ghost-danger btn-icon" data-satir-sil <%= n ? 'disabled' : '' %> title="<%= n ? 'Talepte girildiği için silinemez' : 'Kaldır' %>"><i class="ti ti-trash"></i></button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="d-none text-secondary text-center py-3" data-satir-bos="satirlar">Tanımlı tür yok.</div>
  </div>
  <template id="satirlar-sablon">
    <tr>
      <td class="text-secondary"><span class="satir-no"></span></td>
      <td><input type="hidden" name="satirlar[__i__][kod]" value=""><input type="text" name="satirlar[__i__][ad]" class="form-control" placeholder="ör. Kanatlı"></td>
      <td><input type="text" name="satirlar[__i__][birim]" class="form-control" placeholder="adet"></td>
      <td><span class="badge bg-green-lt">Yeni</span></td>
      <td class="sil-sutunu"><button type="button" class="btn btn-ghost-danger btn-icon" data-satir-sil title="Kaldır"><i class="ti ti-trash"></i></button></td>
    </tr>
  </template>
  <div class="card-footer text-end">
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
  </div>
</form>
<%- include('_son') %>
