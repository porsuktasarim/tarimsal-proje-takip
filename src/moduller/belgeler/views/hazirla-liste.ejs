<%- include('../../../views/partials/ust') %>
<%- include('../../../views/partials/sayfa-basligi', { ustBaslik: proje.kisaAd || proje.ad }) %>
<%
  var sorular = [
    ['s1', 'Faaliyetler planlandığı gibi yürütülüyor mu?', 'metin'],
    ['s2', 'Çıktılar beklenildiği gibi gerçekleşiyor mu?', 'eh'],
    ['s3', 'Beklenmedik bir durum var mı? Varsa proje revize edilmeli mi?', 'eh'],
    ['s4', 'Faaliyetler için ihtiyaç duyulan girdiler planlanan bütçe çerçevesinde temin edildi mi?', 'eh'],
    ['s5', 'Yerel katkı gerçekleşti mi?', 'ekh'],
    ['s6', 'Faaliyetler sonucunda istenen neticelere ulaşıldı mı?', 'metin']
  ];
%>
<div class="page-body">
  <div class="container-xl">
    <form method="get" action="/belgeler/<%= form %>" class="card" style="max-width: 56rem">
      <input type="hidden" name="proje" value="<%= proje._id %>">
      <div class="card-header">
        <div>
          <h3 class="card-title"><%= tanim.ad %></h3>
          <p class="card-subtitle">Bu bilgiler yalnızca bu çıktıya yazılır; boş bırakılanlar formda noktalı çıkar. Sayısal bilgiler başvurulardan hesaplanır.</p>
        </div>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">İlçe</label>
            <select name="ilce" class="form-select">
              <option value="">İl geneli</option>
              <% ilceler.forEach(function (i) { %><option <%= ilce === i ? 'selected' : '' %>><%= i %></option><% }) %>
            </select>
          </div>
          <% if (form === 'izleme') { %>
            <div class="col-md-4">
              <label class="form-label">İzleme dönemi (tarih)</label>
              <input type="date" name="tarih" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label">İzleme faaliyetini yürütenler</label>
              <select name="yurutenler" class="form-select" multiple size="5">
                <% kisiler.forEach(function (k) { %>
                  <option value="<%= k._id %>" <%= ekip.indexOf(String(k._id)) >= 0 ? 'selected' : '' %>><%= k.adSoyad %><%= k.unvan ? ' · ' + k.unvan : '' %><%= k.eposta ? ' · ' + k.eposta : '' %></option>
                <% }) %>
              </select>
              <small class="form-hint">Projenin koordinatör ve yürütücüleri seçili gelir; adla birlikte e-posta ve telefonları yazılır (Ayarlar › Kişiler).</small>
            </div>
            <div class="col-12"><div class="hr-text my-1">İzleme dönemi proje faaliyetleri</div></div>
            <% sorular.forEach(function (q) { %>
              <div class="col-md-5 small fw-medium"><%= q[1] %></div>
              <div class="col-md-7">
                <% if (q[2] !== 'metin') { %>
                  <div class="mb-1">
                    <label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="<%= q[0] %>" value="evet"><span class="form-check-label">Evet</span></label>
                    <% if (q[2] === 'ekh') { %><label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="<%= q[0] %>" value="kismen"><span class="form-check-label">Kısmen</span></label><% } %>
                    <label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="<%= q[0] %>" value="hayir"><span class="form-check-label">Hayır</span></label>
                  </div>
                <% } %>
                <textarea name="<%= q[0] %>a" rows="<%= q[2] === 'metin' ? 2 : 1 %>" class="form-control form-control-sm" placeholder="<%= q[2] === 'metin' ? 'Açıklama' : 'Açıklama (gerekirse)' %>"></textarea>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-md-4">
              <label class="form-label">Yazı tarihi</label>
              <input type="date" name="tarih" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Sayı</label>
              <input type="text" name="sayi" class="form-control" placeholder="EBYS'de verilir">
            </div>
            <div class="col-md-4">
              <label class="form-label">Belgelerin son gönderim tarihi</label>
              <input type="date" name="sonTarih" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">İmzacı</label>
              <input type="text" name="imzaciAd" class="form-control" placeholder="Adı soyadı">
            </div>
            <div class="col-md-4">
              <label class="form-label">Unvanı</label>
              <input type="text" name="imzaciUnvan" class="form-control" placeholder="İl Müdürü a. İl Müdür Yardımcısı">
            </div>
            <div class="col-12 small text-secondary">
              Torba fiyatı ve katkı payı projenin kalem fiyatlarından, hesap bilgisi Ayarlar › Genel'den (ya da projenin Formlar bölümünden), proje kodu projenin Formlar bölümünden alınır. Çiftçi listesi yazının ekinde ilçe ilçe yer alır.
            </div>
          <% } %>
        </div>
      </div>
      <div class="card-footer d-flex flex-wrap gap-2">
        <button class="btn btn-danger" name="bicim" value="pdf" formtarget="_blank"><i class="ti ti-file-type-pdf me-1"></i> PDF</button>
        <button class="btn btn-primary" name="bicim" value="docx"><i class="ti ti-file-type-docx me-1"></i> Word</button>
        <button class="btn btn-success" name="bicim" value="xlsx"><i class="ti ti-file-spreadsheet me-1"></i> Excel</button>
      </div>
    </form>
    <div class="mt-3"><a href="/belgeler?proje=<%= proje._id %>"><i class="ti ti-arrow-left me-1"></i>Formlara dön</a></div>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
