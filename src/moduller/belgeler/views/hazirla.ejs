<%- include('../../../views/partials/ust') %>
<%- include('../../../views/partials/sayfa-basligi', { ustBaslik: talep.ciftciId.adSoyad + ' · ' + talep.ilce }) %>
<div class="page-body">
  <div class="container-xl">
    <%- include('../../../views/partials/bildirim') %>
    <form method="get" action="/belgeler/<%= form %>" class="card" style="max-width: 46rem">
      <input type="hidden" name="talep" value="<%= talep._id %>">
      <input type="hidden" name="ilce" value="<%= talep.ilce %>">
      <input type="hidden" name="donus" value="<%= donus %>">
      <div class="card-header">
        <div>
          <h3 class="card-title"><%= tanim.kod %> <%= tanim.ad %></h3>
          <p class="card-subtitle">Bu bilgiler yalnızca bu çıktıya yazılır; boş bırakılanlar formda boş çıkar.</p>
        </div>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-5">
            <label class="form-label">Sözleşme tarihi</label>
            <input type="date" name="sozlesmeTarihi" class="form-control">
            <small class="form-hint">Girilmezse gün ve ay boş, yıl projeden yazılır.</small>
          </div>
          <div class="col-12"><div class="hr-text my-1"><%= talep.ilce %> İlçe Tarım ve Orman Müdürlüğü imzası</div></div>
          <div class="col-md-7">
            <label class="form-label">Adı soyadı</label>
            <input type="text" name="yetkiliAd" value="<%= kayit.ad || '' %>" class="form-control" placeholder="İlçe müdürü">
          </div>
          <div class="col-md-5">
            <label class="form-label">Unvanı</label>
            <input type="text" name="yetkiliUnvan" value="<%= kayit.unvan || '' %>" class="form-control" placeholder="İlçe Müdürü">
          </div>
          <div class="col-12 small text-secondary">
            <% if (kayit.ad) { %>Kayıtlı ilçe müdürü: <%= kayit.ad %><%= kayit.guncelleyenAd ? ' · güncelleyen ' + kayit.guncelleyenAd : '' %>. <% } %>
            Burada değiştirilen ad yalnızca bu çıktıya yazılır<% if (duzenlenebilir) { %>; ilçe kaydını da değiştirmek için "İlçe müdürü olarak kaydet" düğmesi kullanılır<% } %>.
          </div>
        </div>
      </div>
      <div class="card-footer d-flex flex-wrap gap-2">
        <button class="btn btn-danger" name="bicim" value="pdf" formtarget="_blank"><i class="ti ti-file-type-pdf me-1"></i> PDF</button>
        <button class="btn btn-primary" name="bicim" value="docx"><i class="ti ti-file-type-docx me-1"></i> Word</button>
        <button class="btn btn-success" name="bicim" value="xlsx"><i class="ti ti-file-spreadsheet me-1"></i> Excel</button>
        <% if (duzenlenebilir) { %>
          <button class="btn ms-auto" formmethod="post" formaction="/belgeler/ilce-yetkilisi"><i class="ti ti-device-floppy me-1"></i> İlçe müdürü olarak kaydet</button>
        <% } %>
      </div>
    </form>
    <div class="mt-3"><a href="/talepler/<%= talep._id %>"><i class="ti ti-arrow-left me-1"></i>Başvuruya dön</a></div>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
