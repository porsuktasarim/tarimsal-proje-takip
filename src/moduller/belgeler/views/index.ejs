<%- include('../../../views/partials/ust') %>
<%- include('../../../views/partials/sayfa-basligi', { ustBaslik: proje ? (proje.kisaAd || proje.ad) : 'Uygulama talimatı ekleri' }) %>
<%
  var td = sabitler.talepDurumlari;
  var bicimDugmeleri = function (adres) {
    var s = adres.indexOf('?') >= 0 ? '&' : '?';
    return '<a class="btn btn-sm btn-ghost-danger px-2" title="PDF" target="_blank" href="' + adres + s + 'bicim=pdf"><i class="ti ti-file-type-pdf"></i></a>' +
      '<a class="btn btn-sm btn-ghost-primary px-2" title="Word" href="' + adres + s + 'bicim=docx"><i class="ti ti-file-type-docx"></i></a>' +
      '<a class="btn btn-sm btn-ghost-success px-2" title="Excel" href="' + adres + s + 'bicim=xlsx"><i class="ti ti-file-spreadsheet"></i></a>';
  };
  var listeFormlari = Object.keys(FORMLAR).filter(function (k) { return FORMLAR[k].liste; });
  var tekilFormlar = Object.keys(FORMLAR).filter(function (k) { return FORMLAR[k].tekil; });
  var ilceParam = ilce ? '&ilce=' + encodeURIComponent(ilce) : '';
%>
<div class="page-body">
  <div class="container-xl">
    <% if (!proje) { %>
      <div class="card"><div class="card-body text-secondary">Henüz proje yok.</div></div>
    <% } else { %>
      <form class="row g-2 mb-3" method="get" action="/belgeler">
        <div class="col-12 col-md-5">
          <select name="proje" class="form-select" onchange="this.form.submit()">
            <% projeler.forEach(function (p) { %><option value="<%= p._id %>" <%= String(p._id) === String(proje._id) ? 'selected' : '' %>><%= p.kisaAd || p.ad %><%= p.donem ? ' (' + p.donem + ')' : '' %></option><% }) %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <select name="ilce" class="form-select" onchange="this.form.submit()">
            <option value="">İl geneli</option>
            <% ilceler.forEach(function (i) { %><option <%= ilce === i ? 'selected' : '' %>><%= i %></option><% }) %>
          </select>
        </div>
        <div class="col-12 col-md-4 text-md-end align-self-center small text-secondary">
          Form başlıkları ve imzalar: <a href="/projeler/<%= proje._id %>/duzenle#formlar">proje ayarları › Formlar</a>
        </div>
      </form>

      <div class="row row-cards">
        <div class="col-12">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Liste formları</h3></div>
            <div class="list-group list-group-flush">
              <% listeFormlari.forEach(function (k) { var f = FORMLAR[k]; %>
                <div class="list-group-item d-flex align-items-center gap-1 py-2">
                  <div class="flex-fill">
                    <div><strong><%= f.kod %></strong> <%= f.ad %></div>
                    <div class="small text-secondary"><%= sayilar[f.kapsam] || 0 %> başvuru<%= k === 'kontrol-raporu' ? ' · ' + (sayilar.kontrol || 0) + ' saha kontrolü' : '' %></div>
                  </div>
                  <%- bicimDugmeleri('/belgeler/' + k + '?proje=' + proje._id + ilceParam) %>
                </div>
              <% }) %>
            </div>
            <div class="card-footer small text-secondary">
              PDF tarayıcıda açılır; Word ve Excel indirilir. EK-3 kesin icmal desteklenen ve teslim edilen başvuruları, asıl/yedek liste ilçe bazında karar verilenleri içerir. EK-5'in boş hâli sahada elle doldurmak içindir; üretici ve parsel bilgileri dolu gelir.
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Başvuru formları</h3>
              <div class="card-actions small text-secondary"><%= talepler.length %> başvuru</div>
            </div>
            <div class="table-responsive" style="max-height: 70vh">
              <table class="table table-vcenter card-table table-sm">
                <thead class="sticky-top bg-white">
                  <tr><th>Üretici</th><th>İlçe</th><th>Aşama</th><% tekilFormlar.forEach(function (k) { %><th class="text-center"><%= FORMLAR[k].kod %></th><% }) %></tr>
                </thead>
                <tbody>
                  <% if (!talepler.length) { %><tr><td colspan="<%= 3 + tekilFormlar.length %>" class="text-secondary">Başvuru yok.</td></tr><% } %>
                  <% talepler.forEach(function (t) { var d = td[t.durum] || {}; %>
                    <tr>
                      <td class="text-nowrap"><a href="/talepler/<%= t._id %>"><%= t.ciftciId.adSoyad %></a><div class="small text-secondary"><%= t.ciftciId.mahalle || '' %></div></td>
                      <td><%= t.ilce %></td>
                      <td><span class="badge bg-<%= d.renk %>-lt"><%= d.ad %></span></td>
                      <% tekilFormlar.forEach(function (k) { var f = FORMLAR[k]; var uygun = KAPSAM[f.kapsam].indexOf(t.durum) >= 0; %>
                        <td class="text-center text-nowrap">
                          <% if (!uygun) { %><span class="text-secondary">–</span>
                          <% } else if (k === 'ek5') { %>
                            <% (t.kontroller || []).forEach(function (kn) { %>
                              <div class="d-flex align-items-center justify-content-center"><span class="small me-1"><%= y.tarih(kn.tarih) %></span><%- bicimDugmeleri('/belgeler/ek5?talep=' + t._id + '&kontrol=' + kn._id) %></div>
                            <% }) %>
                            <div class="d-flex align-items-center justify-content-center"><span class="small text-secondary me-1">Boş</span><%- bicimDugmeleri('/belgeler/ek5?talep=' + t._id) %></div>
                          <% } else { %>
                            <%- bicimDugmeleri('/belgeler/' + k + '?talep=' + t._id) %>
                          <% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
