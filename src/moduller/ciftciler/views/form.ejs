<%- include('../../../views/partials/ust') %>
<% var yeni = !ciftci._id; %>
<%- include('../../../views/partials/sayfa-basligi', { ustBaslik: 'Çiftçiler', eylemler: '' }) %>
<div class="page-body">
  <div class="container-xl">
    <%- include('../../../views/partials/hatalar') %>
    <% if (locals.mevcut) { %>
      <div class="alert alert-info"><div>Kayıtlı çiftçiyi görmek için: <a href="/ciftciler/<%= mevcut._id %>"><%= mevcut.adSoyad %></a></div></div>
    <% } %>
    <form method="post" action="<%= eylem %>" class="card" autocomplete="off" style="max-width: 56rem">
      <div class="card-header"><h3 class="card-title"><%= yeni ? 'Yeni çiftçi' : ciftci.adSoyad %></h3></div>
      <div class="card-body">
        <%- include('../../../views/partials/ciftci-alanlari', { c: ciftci, ilceler: ilceler, onek: '', sorgu: false }) %>
        <div class="mt-3">
          <label class="form-label">Not</label>
          <textarea name="aciklama" rows="2" class="form-control"><%= ciftci.aciklama || '' %></textarea>
        </div>
      </div>
      <div class="card-footer d-flex justify-content-end gap-2">
        <a href="<%= yeni ? '/ciftciler' : '/ciftciler/' + ciftci._id %>" class="btn btn-ghost-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Kaydet</button>
      </div>
    </form>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
