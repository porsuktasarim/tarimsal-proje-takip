<%- include('../../../views/partials/ust') %>
<%- include('../../../views/partials/sayfa-basligi', {
      ustBaslik: proje ? (proje.kisaAd || proje.ad) : 'Projeler',
      eylemler: proje ? '<a href="/degerlendirme/icmal?proje=' + proje._id + '" class="btn"><i class="ti ti-report-money me-1"></i> Destek icmali</a>' : ''
    }) %>
<%
  var td = sabitler.talepDurumlari;
  var url = function (degisen) {
    var f = Object.assign({}, filtre, degisen);
    return '/degerlendirme?' + Object.keys(f).filter(function (k) { return f[k]; }).map(function (k) { return k + '=' + encodeURIComponent(f[k]); }).join('&');
  };
%>
<div class="page-body">
  <div class="container-xl">
    <%- include('../../../views/partials/bildirim') %>
    <% if (!proje) { %>
      <div class="card"><div class="card-body text-secondary">Henüz proje yok.</div></div>
    <% } else { %>

      <!-- Aşama özetleri -->
      <div class="row row-cards mb-3">
        <div class="col-lg-8">
          <div class="card card-sm"><div class="card-body">
            <div class="d-flex flex-wrap gap-2">
              <% Object.keys(td).forEach(function (k) { var n = sayilar[k] || 0; var d = td[k]; %>
                <a href="<%= url({ asama: k }) %>" class="btn btn-sm <%= filtre.asama === k ? 'btn-' + d.renk : 'btn-outline-' + d.renk %><%= n ? '' : ' opacity-50' %>">
                  <i class="ti <%= d.ikon %> me-1"></i><%= d.ad %> <span class="badge ms-1 bg-<%= filtre.asama === k ? 'white text-' + d.renk : d.renk + '-lt' %>"><%= n %></span>
                </a>
              <% }) %>
            </div>
          </div></div>
        </div>
        <div class="col-lg-4">
          <div class="card card-sm"><div class="card-body">
            <div class="text-secondary small">Desteklenen (<%= destek.ciftci %> çiftçi)</div>
            <div class="h3 mb-0"><%= y.para(destek.bedel) %>
              <% if (butce.toplam) { %><span class="fs-5 text-secondary fw-normal">/ <%= y.para(butce.toplam) %> · %<%= Math.round(100 * destek.bedel / butce.toplam) %></span><% } %></div>
            <div class="small text-secondary">Çiftçi katkısı <%= y.para(destek.ciftciKatkisi) %></div>
          </div></div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <form class="row g-2 w-100" method="get" action="/degerlendirme">
            <div class="col-12 col-md-3">
              <select name="proje" class="form-select" onchange="this.form.submit()">
                <% projeler.forEach(function (p) { %><option value="<%= p._id %>" <%= String(p._id) === filtre.proje ? 'selected' : '' %>><%= p.kisaAd || p.ad %><%= p.donem ? ' (' + p.donem + ')' : '' %></option><% }) %>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <select name="asama" class="form-select" onchange="this.form.submit()">
                <% Object.keys(ASAMA_GRUPLARI).forEach(function (k) { %><option value="<%= k %>" <%= filtre.asama === k ? 'selected' : '' %>><%= ASAMA_GRUPLARI[k].ad %></option><% }) %>
                <% Object.keys(td).forEach(function (k) { %><option value="<%= k %>" <%= filtre.asama === k ? 'selected' : '' %>><%= td[k].ad %></option><% }) %>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <select name="ilce" class="form-select" onchange="this.form.mahalle.value=''; this.form.submit()">
                <option value="">İl geneli</option>
                <% ayar.ilceler.forEach(function (i) { %><option <%= filtre.ilce === i ? 'selected' : '' %>><%= i %></option><% }) %>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <select name="mahalle" class="form-select" onchange="this.form.submit()">
                <option value="">Tüm mahalleler</option>
                <% mahalleler.forEach(function (m) { %><option <%= filtre.mahalle === m ? 'selected' : '' %>><%= m %></option><% }) %>
              </select>
            </div>
            <div class="col-6 col-md">
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                <input type="search" name="q" value="<%= filtre.q %>" class="form-control" placeholder="Ad ya da T.C.">
              </div>
            </div>
            <div class="col-auto d-flex align-items-center">
              <label class="form-check form-switch mb-0" title="Projede tanımlı limitleri aşan başvurular">
                <input class="form-check-input" type="checkbox" name="limit" value="1" <%= filtre.limit === '1' ? 'checked' : '' %> onchange="this.form.submit()">
                <span class="form-check-label">Limit üstü <span class="badge bg-yellow-lt"><%= limitUstu %></span></span>
              </label>
            </div>
          </form>
        </div>

        <% if (limitler.length) { %>
          <div class="card-body py-2 small text-secondary border-bottom">
            <i class="ti ti-ruler-measure me-1"></i> Limitler:
            <% limitler.forEach(function (l, i) { %><%= i ? ' · ' : '' %><%= l.ad || l.ifade %> ≤ <%= y.sayi(l.ust) %> <%= l.birim || '' %><% }) %>
          </div>
        <% } %>

        <% if (!satirlar.length) { %>
          <div class="empty">
            <div class="empty-icon"><i class="ti ti-list-check" style="font-size:3rem"></i></div>
            <p class="empty-title">Başvuru yok</p>
            <p class="empty-subtitle text-secondary">Bu süzgeçle değerlendirilecek başvuru bulunmuyor.</p>
          </div>
        <% } else { %>
          <form method="post" action="/degerlendirme/toplu" id="toplu-formu" data-islem-formu>
            <input type="hidden" name="donus" value="<%= donus %>">
            <%
              var kalemler = proje.kalemler;
              var hayvanlar = ayar.hayvanTurleri;
              var sutunSayisi = 4 + kalemler.length * 2 + hayvanlar.length + 3 + (uretimler.length ? 1 : 0) + formuller.length + 2;
              var dv = function (v) { return v == null || v === '' ? '' : v; };
            %>
            <div class="izgara-kaydet d-none" data-izgara-kaydet>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <span><i class="ti ti-pencil me-1"></i><strong data-degisen-sayi>0</strong> başvuruda değişiklik</span>
                <input type="text" class="form-control form-control-sm flex-fill" style="min-width:16rem" data-izgara-not placeholder="Not / gerekçe (miktar düşürülürken zorunlu; değişen tüm başvurulara yazılır)">
                <button type="button" class="btn btn-sm btn-primary" data-izgara-kaydet-dugme><i class="ti ti-device-floppy me-1"></i> Değişiklikleri kaydet</button>
                <button type="button" class="btn btn-sm" data-izgara-vazgec>Vazgeç</button>
              </div>
            </div>
            <div class="izgara-cerceve">
              <table class="table table-sm card-table izgara" data-siralanabilir data-izgara>
                <thead>
                  <tr class="izgara-grup">
                    <th colspan="4" class="izgara-sabit-baslik"></th>
                    <th colspan="<%= kalemler.length %>" class="text-center grup-duzenlenir">Talep edilen <span class="fw-normal">(geçerli · düzenlenir)</span></th>
                    <th colspan="<%= hayvanlar.length %>" class="text-center grup-duzenlenir">Hayvan <span class="fw-normal">(düzenlenir)</span></th>
                    <th colspan="<%= kalemler.length + 3 %>" class="text-center">Hesap</th>
                    <% if (uretimler.length) { %><th class="text-center grup-uretim"></th><% } %>
                    <% if (formuller.length) { %><th colspan="<%= formuller.length %>" class="text-center grup-formul">Formüller</th><% } %>
                    <th colspan="2"></th>
                  </tr>
                  <tr>
                    <th class="w-1 izgara-sabit s0"><input type="checkbox" class="form-check-input" data-tumunu-sec></th>
                    <th class="izgara-sabit s1" data-sirala="metin">Çiftçi</th>
                    <th data-sirala="metin">İlçe / mahalle</th>
                    <th data-sirala="metin">Aşama</th>
                    <% kalemler.forEach(function (k) { %><th class="tablo-sayi grup-duzenlenir" data-sirala="sayi" title="<%= kalemAdi(k) %>"><%= k.urun %><%= k.cesit ? ' ' + k.cesit : '' %> <span class="fw-normal">(<%= k.talepBirimi || 'da' %>)</span></th><% }) %>
                    <% hayvanlar.forEach(function (h) { %><th class="tablo-sayi grup-duzenlenir" data-sirala="sayi"><%= h.ad %></th><% }) %>
                    <% kalemler.forEach(function (k) { %><th class="tablo-sayi" data-sirala="sayi" title="<%= kalemAdi(k) %> dağıtım"><%= k.urun %> <span class="fw-normal">(<%= k.olcuBirimi %>)</span></th><% }) %>
                    <th class="tablo-sayi" data-sirala="sayi" title="BBHB kaydı; ~ ile başlayan beyandan tahmin">BBHB</th>
                    <th class="tablo-sayi" data-sirala="sayi">Bedel</th>
                    <th class="tablo-sayi" data-sirala="sayi">Çiftçi katkısı</th>
                    <% if (uretimler.length) { %><th class="tablo-sayi grup-uretim" data-sirala="sayi" title="Talep edilen miktar × çıktı normu: <%= uretimler.map(function (u) { return u.ad; }).join(', ') %>">Beklenen üretim</th><% } %>
                    <% formuller.forEach(function (f) { %><th class="tablo-sayi grup-formul" data-sirala="sayi" title="<%= f.ifade %>"><%= f.ad %><%= f.birim ? ' (' + f.birim + ')' : '' %><%- f.puan ? ' <span class="badge bg-purple-lt">puan</span>' : '' %></th><% }) %>
                    <th>Son not</th>
                    <th class="w-1"></th>
                  </tr>
                </thead>
                <tbody>
                  <% satirlar.forEach(function (s) {
                       var t = s.talep, c = s.ciftci, d = td[t.durum], hc = hucreler(s, proje, uretimler);
                       var duzenlenir = t.durum === 'incelemede';
                       var ilkHv = (t.basvuru && t.basvuru.hayvanlar) || {};
                       var hv = t.hayvanlar || {}; %>
                    <tr id="b-<%= t._id %>" data-talep="<%= t._id %>" class="<%= hc.limit.deger ? 'limit-ustu' : '' %><%= duzenlenir ? '' : ' izgara-kilitli' %>">
                      <td class="izgara-sabit s0"><input type="checkbox" class="form-check-input" name="ids" value="<%= t._id %>" data-secim></td>
                      <td class="izgara-sabit s1" data-deger="<%= c.adSoyad %>">
                        <a href="/talepler/<%= t._id %>" class="text-reset fw-medium text-nowrap"><%= c.adSoyad %></a>
                        <div class="small text-secondary font-monospace text-nowrap"><%= c.tcKimlikNo %><%- c.cks ? ' <span class="badge bg-green-lt">ÇKS</span>' : '' %></div>
                      </td>
                      <td class="small text-nowrap" data-deger="<%= t.ilce %> <%= c.mahalle || '' %>"><%= t.ilce %><% if (c.mahalle) { %><div class="text-secondary"><%= c.mahalle %></div><% } %></td>
                      <td data-deger="<%= d.ad %>" class="text-nowrap">
                        <span class="badge bg-<%= d.renk %>-lt"><%= d.ad %></span>
                        <div data-hucre="limit" title="<%= hc.limit.ipucu %>" class="small text-warning"><%= hc.limit.metin %></div>
                      </td>
                      <% kalemler.forEach(function (k) {
                           var id = String(k._id);
                           var hk = s.hesap.kalemler.find(function (x) { return String(x.kalem._id) === id; });
                           var deger = hk && hk.talepMiktari != null ? hk.talepMiktari : '';
                           var ilk = s.ilk[id]; %>
                        <td class="izgara-giris tablo-sayi" data-deger="<%= hk ? hk.esasMiktari : 0 %>">
                          <input type="number" step="any" min="0" class="izgara-hucre" data-alan="talepKalemleri" data-anahtar="<%= id %>"
                                 value="<%= dv(deger) %>" data-ilk="<%= dv(deger) %>" <%= duzenlenir ? '' : 'disabled' %>
                                 placeholder="<%= hk && hk.parselMiktari != null && deger === '' ? hk.parselMiktari : '' %>"
                                 title="<%= hk && hk.parselMiktari != null ? 'Parsellerde ' + y.sayi(hk.parselMiktari) + ' ' + (k.talepBirimi || 'da') : '' %>">
                          <% if (ilk != null && ilk !== (deger === '' ? null : deger)) { %><div class="izgara-eski" title="Başvurudaki miktar"><%= y.sayi(ilk) %></div><% } %>
                        </td>
                      <% }) %>
                      <% hayvanlar.forEach(function (h) { %>
                        <td class="izgara-giris tablo-sayi" data-deger="<%= hv[h.kod] || 0 %>">
                          <input type="number" step="1" min="0" class="izgara-hucre" data-alan="hayvanlar" data-anahtar="<%= h.kod %>"
                                 value="<%= dv(hv[h.kod]) %>" data-ilk="<%= dv(hv[h.kod]) %>" <%= duzenlenir ? '' : 'disabled' %>>
                          <% if (ilkHv[h.kod] != null && ilkHv[h.kod] !== hv[h.kod]) { %><div class="izgara-eski" title="Başvurudaki sayı"><%= y.sayi(ilkHv[h.kod]) %></div><% } %>
                        </td>
                      <% }) %>
                      <% kalemler.forEach(function (k) { var x = hc['dagitim:' + k._id]; %>
                        <td class="tablo-sayi text-nowrap" data-hucre="dagitim:<%= k._id %>" data-deger="<%= dv(x.deger) %>" title="<%= x.ipucu %>"><%= x.metin %></td>
                      <% }) %>
                      <td class="tablo-sayi text-nowrap" data-hucre="bbhb" data-deger="<%= dv(hc.bbhb.deger) %>" title="<%= hc.bbhb.ipucu %>"><%= hc.bbhb.metin %></td>
                      <td class="tablo-sayi text-nowrap" data-hucre="bedel" data-deger="<%= dv(hc.bedel.deger) %>" data-toplam="para"><%= hc.bedel.metin %></td>
                      <td class="tablo-sayi text-nowrap" data-hucre="katki" data-deger="<%= dv(hc.katki.deger) %>" data-toplam="para"><%= hc.katki.metin %></td>
                      <% if (uretimler.length) { %>
                        <td class="tablo-sayi text-nowrap grup-uretim izgara-cok-satir" data-hucre="uretim" data-deger="<%= dv(hc.uretim.deger) %>" data-uretimler="<%= JSON.stringify(hc.uretim.degerler) %>"><%= hc.uretim.metin %></td>
                      <% } %>
                      <% formuller.forEach(function (f) { var x = hc['f:' + f.kod]; %>
                        <td class="tablo-sayi text-nowrap grup-formul<%= f.puan ? ' fw-bold' : '' %><%= x.ipucu ? ' text-danger' : '' %>" data-hucre="f:<%= f.kod %>" data-deger="<%= dv(x.deger) %>" data-toplam="sayi" title="<%= x.ipucu %>"><%= x.metin %></td>
                      <% }) %>
                      <td class="small text-secondary"><% if (s.sonNot) { %><div class="text-truncate" style="max-width: 12rem" title="<%= s.sonNot.kisiAd %>: <%= s.sonNot.not %>"><i class="ti ti-message"></i> <%= s.notSayisi %> · <%= s.sonNot.not %></div><% } %></td>
                      <td>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#panel-penceresi"
                                data-panel="/degerlendirme/<%= t._id %>/panel?donus=<%= encodeURIComponent(donus) %>">Aç</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot>
                  <tr class="fw-bold" data-toplam-satiri>
                    <td class="izgara-sabit s0"></td>
                    <td class="izgara-sabit s1"><%= satirlar.length %> başvuru</td>
                    <td colspan="2"></td>
                    <% kalemler.forEach(function () { %><td class="tablo-sayi" data-toplam-sutun="sayi"></td><% }) %>
                    <% hayvanlar.forEach(function () { %><td class="tablo-sayi" data-toplam-sutun="sayi"></td><% }) %>
                    <% kalemler.forEach(function () { %><td class="tablo-sayi" data-toplam-sutun="sayi"></td><% }) %>
                    <td class="tablo-sayi" data-toplam-sutun="sayi"></td>
                    <td class="tablo-sayi" data-toplam-sutun="para"></td>
                    <td class="tablo-sayi" data-toplam-sutun="para"></td>
                    <% if (uretimler.length) { %><td class="tablo-sayi izgara-cok-satir" data-toplam-sutun="uretim" data-uretim-tanim="<%= JSON.stringify(uretimler.map(function (u) { return { kod: u.kod, ad: u.kisaAd, birim: u.birim }; })) %>"></td><% } %>
                    <% formuller.forEach(function () { %><td class="tablo-sayi" data-toplam-sutun="sayi"></td><% }) %>
                    <td colspan="2"></td>
                  </tr>
                </tfoot>
              </table>
            </div>

            <div class="card-footer toplu-islem">
              <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-auto"><span class="text-secondary text-nowrap"><span data-secili-sayi>0</span> başvuru seçili</span></div>
                <div class="col-12 col-lg-4">
                  <textarea name="not" rows="1" class="form-control form-control-sm" placeholder="Not / gerekçe (seçilen tüm başvurulara yazılır; silinemez)"></textarea>
                </div>
                <div class="col-12 col-lg d-flex flex-wrap gap-1">
                  <% toplu.forEach(function (i) { %>
                    <button type="submit" name="islem" value="<%= i.kod %>" class="btn btn-sm btn-outline-<%= i.renk %>" data-toplu-dugme disabled
                            <% if (i.notZorunlu && i.notZorunlu({ durum: 'incelemede' })) { %>data-not-zorunlu="<%= i.notEtiket %>"<% } %>><i class="ti <%= i.ikon %> me-1"></i><%= i.ad %></button>
                  <% }) %>
                </div>
              </div>
              <div class="small text-secondary mt-2">
                Toplu işlem yalnızca uygun aşamadaki başvurularda yapılır (ör. teslim alma yalnızca gönderilmiş başvurularda).
                Talep ve hayvan hücreleri incelemedeki başvurularda doğrudan değiştirilir; satır hemen yeniden hesaplanır, kaydedilene kadar değişiklikler sarı görünür. Altındaki gri sayı başvurudaki ilk değerdir.
                Enter / ↑ ↓ ile satırlar arasında, Tab ile hücreler arasında geçilir; Esc hücreyi geri alır. Sütun başlığına tıklanarak sıralanır<%= puanVar ? '; varsayılan sıra puana göredir' : '' %>.
              </div>
            </div>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<div class="modal modal-blur fade" id="panel-penceresi" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Başvuru değerlendirmesi</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body" data-panel-icerik><div class="text-secondary">Yükleniyor…</div></div>
    </div>
  </div>
</div>
<%- include('../../../views/partials/alt') %>
